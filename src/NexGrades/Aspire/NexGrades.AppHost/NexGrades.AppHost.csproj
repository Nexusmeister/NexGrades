<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.5" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Aspire 13.6 warns that the AppHost does not use the Aspire CLI bundle. This dev-time host runs from the
         packages (dashboard and DCP come from the Aspire.Dashboard.Sdk and Aspire.Hosting.Orchestration packages), so
         the bundle is not needed. This is not a NuGet audit warning. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>f54a1580-bcfc-446f-ba0c-1065d1a39ecb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NexGrades.App\NexGrades.App.csproj" />
  </ItemGroup>

</Project>
