<UserControl x:Class="NexGrades.App.Core.YearLock.YearLockBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:NexGrades.App.Localization"
             xmlns:yearLock="clr-namespace:NexGrades.App.Core.YearLock"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance yearLock:YearLockViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- A closed InfoBar takes no space, so the control collapses when the year is neither locked nor unlocked. -->
    <StackPanel>
        <ui:InfoBar IsClosable="False"
                    Severity="Warning"
                    Title="{loc:Text Core_YearLock_Closed_Title}"
                    Message="{Binding LockedMessage}"
                    IsOpen="{Binding IsLocked, Mode=OneWay}">
            <ui:InfoBar.Content>
                <ui:Button Content="{loc:Text Core_YearLock_Unlock}"
                           Icon="{ui:SymbolIcon LockOpen24}"
                           ToolTip="{loc:Text Core_YearLock_Unlock_Tooltip}"
                           AutomationProperties.Name="{loc:Text Core_YearLock_Unlock_A11y}"
                           Command="{Binding UnlockCommand}"/>
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <ui:InfoBar IsClosable="False"
                    Severity="Informational"
                    Title="{loc:Text Core_YearLock_Unlocked_Title}"
                    Message="{Binding UnlockedMessage}"
                    IsOpen="{Binding IsUnlocked, Mode=OneWay}">
            <ui:InfoBar.Content>
                <ui:Button Content="{loc:Text Core_YearLock_Relock}"
                           Icon="{ui:SymbolIcon LockClosed24}"
                           ToolTip="{loc:Text Core_YearLock_Relock_Tooltip}"
                           AutomationProperties.Name="{loc:Text Core_YearLock_Relock_A11y}"
                           Command="{Binding RelockCommand}"/>
            </ui:InfoBar.Content>
        </ui:InfoBar>
    </StackPanel>
</UserControl>
