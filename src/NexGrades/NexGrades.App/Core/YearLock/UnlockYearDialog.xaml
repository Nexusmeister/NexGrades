<ui:ContentDialog x:Class="NexGrades.App.Core.YearLock.UnlockYearDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:NexGrades.App.Localization"
                  xmlns:services="clr-namespace:NexGrades.Domain.Services;assembly=NexGrades.Domain"
                  Title="{Binding Title}"
                  PrimaryButtonText="{loc:Text Core_UnlockDialog_Unlock}"
                  CloseButtonText="{loc:Text Common_Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding IsValid}">

    <!-- Merged here because the dialog must build without the application resources. -->
    <ui:ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:ContentDialog.Resources>

    <StackPanel MinWidth="360" MaxWidth="480">
        <HeaderedContentControl Header="{loc:Text Core_UnlockDialog_Reason_Header}"
                                Style="{StaticResource Ng.FormField}">
            <ui:TextBox Style="{StaticResource Ng.TextBox.Multiline}"
                        MaxLength="{x:Static services:UnlockService.MaxReasonLength}"
                        AutomationProperties.Name="{loc:Text Core_UnlockDialog_Reason_A11y}"
                        PlaceholderText="{loc:Text Core_UnlockDialog_Reason_Placeholder}"
                        Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
        </HeaderedContentControl>

        <HeaderedContentControl Header="{loc:Text Core_UnlockDialog_Duration_Header}"
                                Style="{StaticResource Ng.FormField}">
            <ComboBox HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{loc:Text Core_UnlockDialog_Duration_A11y}"
                      ItemsSource="{Binding DurationChoices}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Option"
                      SelectedValue="{Binding SelectedDuration}" />
        </HeaderedContentControl>

        <HeaderedContentControl Header="{loc:Text Core_UnlockDialog_EndDate_Header}"
                                Style="{StaticResource Ng.FormField}"
                                Visibility="{Binding IsCustomDate, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DatePicker HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{loc:Text Core_UnlockDialog_EndDate_A11y}"
                        DisplayDateStart="{Binding CustomDateStart, Mode=OneWay}"
                        DisplayDateEnd="{Binding CustomDateEnd, Mode=OneWay}"
                        SelectedDate="{Binding CustomDate}" />
        </HeaderedContentControl>

        <!-- Why Unlock is disabled -->
        <ui:TextBlock FontTypography="Caption"
                      Appearance="Secondary"
                      TextWrapping="Wrap"
                      Text="{Binding ValidationMessage}"
                      Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</ui:ContentDialog>
