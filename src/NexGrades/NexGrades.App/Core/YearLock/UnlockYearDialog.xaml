<ui:ContentDialog x:Class="NexGrades.App.Core.YearLock.UnlockYearDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:services="clr-namespace:NexGrades.Domain.Services;assembly=NexGrades.Domain"
                  Title="{Binding Title}"
                  PrimaryButtonText="Unlock"
                  CloseButtonText="Cancel"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding IsValid}">

    <!-- Page-local, like the pages: the dialog must build without App.xaml's resources. -->
    <ui:ContentDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ui:ContentDialog.Resources>

    <StackPanel MinWidth="360" MaxWidth="480">
        <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Reason"/>
        <ui:TextBox MinHeight="72"
                    MaxHeight="120"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    MaxLength="{x:Static services:UnlockService.MaxReasonLength}"
                    AutomationProperties.Name="Reason for unlocking the school year"
                    PlaceholderText="Why does this school year need to be changed?"
                    Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>

        <ui:TextBlock Margin="0,12,0,4" FontTypography="BodyStrong" Text="Unlock for"/>
        <ComboBox HorizontalAlignment="Stretch"
                  AutomationProperties.Name="How long to unlock the school year"
                  ItemsSource="{Binding DurationChoices}"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Option"
                  SelectedValue="{Binding SelectedDuration}"/>

        <StackPanel Margin="0,12,0,0"
                    Visibility="{Binding IsCustomDate, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="End date"/>
            <DatePicker HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Date the unlock ends"
                        DisplayDateStart="{Binding CustomDateStart, Mode=OneWay}"
                        DisplayDateEnd="{Binding CustomDateEnd, Mode=OneWay}"
                        SelectedDate="{Binding CustomDate}"/>
        </StackPanel>

        <!-- Why Unlock is disabled -->
        <ui:TextBlock Margin="0,12,0,0"
                      FontTypography="Caption"
                      Appearance="Secondary"
                      TextWrapping="Wrap"
                      Text="{Binding ValidationMessage}"
                      Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </StackPanel>
</ui:ContentDialog>
