<Page x:Class="NexGrades.App.Features.Home.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="clr-namespace:NexGrades.App.Localization"
      xmlns:home="clr-namespace:NexGrades.App.Features.Home"
      d:DataContext="{d:DesignInstance Type=home:HomeViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Text Home_Page_Title}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{loc:Text Home_Page_Title}"
                                Style="{StaticResource Ng.PageHeader}" />

        <ui:Card Grid.Row="1"
                 Margin="{StaticResource Ng.Margin.ActionBar}"
                 Style="{StaticResource Ng.Card}"
                 Visibility="{Binding IsYearEndReminderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <ui:TextBlock Text="{loc:Text Home_YearEnd_Title}"
                              FontTypography="Subtitle"
                              TextWrapping="Wrap"
                              Margin="{StaticResource Ng.Margin.Tight}" />
                <ui:TextBlock Text="{Binding YearEndReminderMessage}"
                              FontTypography="Body"
                              TextWrapping="Wrap"
                              Margin="{StaticResource Ng.Margin.Related}" />
                <WrapPanel Style="{StaticResource Ng.ActionBar}">
                    <ui:Button Content="{loc:Text Home_YearEnd_Open}"
                               Command="{Binding OpenEndOfYearCommand}"
                               Appearance="Primary"
                               Margin="{StaticResource Ng.Margin.ActionItem}"
                               AutomationProperties.Name="{loc:Text Home_YearEnd_Open}" />
                    <ui:Button Content="{loc:Text Home_YearEnd_NotNow}"
                               Command="{Binding DismissYearEndReminderCommand}"
                               Appearance="Transparent"
                               Margin="{StaticResource Ng.Margin.ActionItem}"
                               AutomationProperties.Name="{loc:Text Home_YearEnd_NotNow}" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="2"
                 VerticalAlignment="Top"
                 Margin="{StaticResource Ng.Margin.ActionBar}"
                 Style="{StaticResource Ng.Card}">
            <ui:TextBlock Text="{Binding WelcomeMessage}"
                          FontTypography="Body"
                          TextWrapping="Wrap" />
        </ui:Card>
    </Grid>
</Page>
