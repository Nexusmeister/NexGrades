<Page x:Class="NexGrades.App.Features.Home.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="clr-namespace:NexGrades.App.Localization"
      xmlns:home="clr-namespace:NexGrades.App.Features.Home"
      d:DataContext="{d:DesignInstance Type=home:HomeViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Text Home_Page_Title}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{loc:Text Home_Page_Title}"
                                Style="{StaticResource Ng.PageHeader}" />

        <ui:Card Grid.Row="1"
                 VerticalAlignment="Top"
                 Margin="{StaticResource Ng.Margin.ActionBar}"
                 Style="{StaticResource Ng.Card}">
            <ui:TextBlock Text="{Binding WelcomeMessage}"
                          FontTypography="Body"
                          TextWrapping="Wrap" />
        </ui:Card>
    </Grid>
</Page>
