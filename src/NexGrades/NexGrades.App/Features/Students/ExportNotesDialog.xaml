<ui:ContentDialog x:Class="NexGrades.App.Features.Students.ExportNotesDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Export notes"
                  PrimaryButtonText="Export"
                  CloseButtonText="Cancel"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding IsValid}">

    <!-- Page-local, like the pages: the dialog must build without App.xaml's resources. -->
    <ui:ContentDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ui:ContentDialog.Resources>

    <StackPanel MinWidth="360"
                MaxWidth="480"
                FocusManager.FocusedElement="{Binding ElementName=FromPicker}">
        <ui:TextBlock Margin="0,0,0,4"
                      FontTypography="BodyStrong"
                      Text="From"/>
        <DatePicker x:Name="FromPicker"
                    HorizontalAlignment="Stretch"
                    TabIndex="0"
                    AutomationProperties.Name="From: first day of the exported notes"
                    SelectedDate="{Binding From}"/>

        <ui:TextBlock Margin="0,12,0,4"
                      FontTypography="BodyStrong"
                      Text="To"/>
        <DatePicker HorizontalAlignment="Stretch"
                    TabIndex="1"
                    AutomationProperties.Name="To: last day of the exported notes"
                    SelectedDate="{Binding To}"/>

        <CheckBox Margin="0,12,0,0"
                  TabIndex="2"
                  Content="Include archived notes"
                  IsChecked="{Binding IncludeArchived}"/>

        <ui:TextBlock Margin="0,12,0,0"
                      FontTypography="Caption"
                      Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                      TextWrapping="Wrap"
                      Text="{Binding ValidationMessage}"
                      Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </StackPanel>
</ui:ContentDialog>
