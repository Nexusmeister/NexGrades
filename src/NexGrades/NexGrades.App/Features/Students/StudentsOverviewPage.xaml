<Page x:Class="NexGrades.App.Features.Students.StudentsOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="clr-namespace:NexGrades.App.Localization"
      xmlns:students="clr-namespace:NexGrades.App.Features.Students"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance students:StudentsOverviewPage, IsDesignTimeCreatable=False}"
      Title="{loc:Text Students_Overview_Title}">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding ViewModel.LoadStudentsCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{loc:Text Students_Overview_Title}"
                                Style="{StaticResource Ng.PageHeader}" />

        <WrapPanel Grid.Row="1" Style="{StaticResource Ng.ActionBar}">
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}" Appearance="Primary"
                       Content="{loc:Text Students_Overview_Add}"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding ViewModel.AddStudentCommand}" />
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                       Content="{loc:Text Students_Overview_Edit}"
                       Icon="{ui:SymbolIcon Edit24}"
                       Command="{Binding ViewModel.EditStudentCommand}" />
        </WrapPanel>

        <ContentControl Grid.Row="2"
                        Content="{loc:Text Students_Overview_Empty}"
                        Tag="{Binding ViewModel.Students}"
                        Style="{StaticResource Ng.EmptyState.WhenNoItemsAfterLoad}" />

        <ui:DataGrid Grid.Row="3"
                     Style="{StaticResource Ng.DataGrid}"
                     ItemsSource="{Binding ViewModel.Students}"
                     SelectedItem="{Binding ViewModel.SelectedStudent, Mode=TwoWay}"
                     MouseDoubleClick="OnStudentsGridMouseDoubleClick">
            <ui:DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ViewModel.EditStudentCommand}" />
            </ui:DataGrid.InputBindings>
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Text Students_Overview_Id_Header}" Binding="{Binding Id}"
                                    ElementStyle="{StaticResource Ng.DataGridText.Numeric}" />
                <DataGridTextColumn Header="{loc:Text Students_Overview_LastName_Header}" Binding="{Binding LastName}" ElementStyle="{StaticResource Ng.DataGridText}" />
                <DataGridTextColumn Header="{loc:Text Students_Overview_FirstName_Header}" Binding="{Binding FirstName}" ElementStyle="{StaticResource Ng.DataGridText}" />
                <DataGridTextColumn Header="{loc:Text Students_Overview_Class_Header}" Binding="{Binding ClassName}" ElementStyle="{StaticResource Ng.DataGridText}" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
