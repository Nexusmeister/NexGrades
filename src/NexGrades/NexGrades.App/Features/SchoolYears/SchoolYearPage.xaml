<Page x:Class="NexGrades.App.Features.SchoolYears.SchoolYearPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:core="clr-namespace:NexGrades.App.Core"
      xmlns:schoolYears="clr-namespace:NexGrades.App.Features.SchoolYears"
      d:DataContext="{d:DesignInstance schoolYears:SchoolYearPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="900"
      Title="School year">

    <!-- Page-local, like ClassPage: the page must build without App.xaml's resources (see NexGrades.App.Tests). -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- One row of the readiness lists: the finding and, when it links somewhere, an Open button. -->
        <DataTemplate x:Key="ReadinessItemTemplate" DataType="{x:Type schoolYears:ReadinessItemRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              FontTypography="Body"
                              TextWrapping="Wrap"
                              Text="{Binding Text}"/>
                <ContentControl Grid.Column="1" IsTabStop="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Target}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                <ui:Button Content="Open"
                           Icon="{ui:SymbolIcon Open24}"
                           ToolTip="Open the page where this can be fixed"
                           AutomationProperties.Name="Open the page where this can be fixed"
                           Command="{Binding DataContext.ViewModel.OpenReadinessItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                           CommandParameter="{Binding}"/>
                </ContentControl>
            </Grid>
        </DataTemplate>

        <!-- One class of the classes step. -->
        <DataTemplate x:Key="ClassRowTemplate" DataType="{x:Type schoolYears:ClassChoiceRow}">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      FontTypography="BodyStrong"
                                      Text="{Binding Name}"/>
                        <ui:TextBlock Grid.Column="1"
                                      FontTypography="Caption"
                                      Appearance="Secondary"
                                      Text="{Binding CarryOverText}"
                                      Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>

                    <!-- Pending: the teacher decides. -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Margin="0,0,16,0"
                                         GroupName="{Binding GroupName}"
                                         Content="Roll forward"
                                         AutomationProperties.Name="Roll this class forward"
                                         IsChecked="{Binding IsRollForwardChosen, Mode=TwoWay}"/>
                            <RadioButton Content="Archive"
                                         GroupName="{Binding GroupName}"
                                         AutomationProperties.Name="Archive this class"
                                         IsChecked="{Binding IsArchiveChosen, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0"
                                    MaxWidth="480"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsRollForwardPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock FontTypography="Caption"
                                          Appearance="Secondary"
                                          Margin="0,0,0,4"
                                          Text="Name in the next school year"/>
                            <ui:TextBox Width="240"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Name of the class in the next school year"
                                        Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <CheckBox Margin="0,8,0,0"
                                  Content="End this class"
                                  AutomationProperties.Name="End this class"
                                  ToolTip="Also ends the class itself, so it does not continue in later school years"
                                  IsChecked="{Binding EndClassGroup, Mode=TwoWay}"
                                  Visibility="{Binding IsArchiveChosen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding HasFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="Warning24"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            <ui:TextBlock MaxWidth="560"
                                          FontTypography="Body"
                                          TextWrapping="Wrap"
                                          Text="{Binding FailedText}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Done: read-only. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsDone, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        <ui:TextBlock FontTypography="Body"
                                      Text="{Binding DoneText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0"
                      FontTypography="Title"
                      Text="School year"/>

        <!-- Empty state: nothing to end. -->
        <StackPanel Grid.Row="1" Grid.RowSpan="3"
                    Margin="0,12,0,0"
                    Visibility="{Binding ViewModel.HasActiveYear, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <ui:InfoBar IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="No active school year"
                        Message="There is no active school year."/>
        </StackPanel>

        <!-- Step header. -->
        <StackPanel Grid.Row="1"
                    Margin="0,12,0,0"
                    Visibility="{Binding ViewModel.HasActiveYear, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="Step 1 of 6: Overview"
                          Visibility="{Binding ViewModel.IsOverviewStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="Step 2 of 6: Next school year"
                          Visibility="{Binding ViewModel.IsNextYearStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="Step 3 of 6: Classes"
                          Visibility="{Binding ViewModel.IsClassesStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="Step 4 of 6: Readiness check"
                          Visibility="{Binding ViewModel.IsReadinessStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="Step 5 of 6: Confirm"
                          Visibility="{Binding ViewModel.IsConfirmStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="Step 6 of 6: Done"
                          Visibility="{Binding ViewModel.IsResultStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Step content. -->
        <ScrollViewer Grid.Row="2"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ViewModel.HasActiveYear, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <ui:ProgressRing IsIndeterminate="True"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Panel.ZIndex="1"
                                 AutomationProperties.Name="Loading"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Overview -->
                <ui:Card Visibility="{Binding ViewModel.IsOverviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="Active school year"/>
                        <ui:TextBlock FontTypography="Subtitle" Margin="0,4,0,0" Text="{Binding ViewModel.ActiveYearLabel}"/>
                        <ui:TextBlock FontTypography="Body" Margin="0,8,0,0"
                                      Text="{Binding ViewModel.ActiveYearStart, StringFormat='Starts on {0:d}'}"/>
                        <ui:TextBlock FontTypography="Body" Margin="0,4,0,0"
                                      Text="{Binding ViewModel.ActiveYearEnd, StringFormat='Ends on {0:d}'}"/>
                        <ui:InfoBar Margin="0,12,0,0"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Not over yet"
                                    Message="The school year has not ended yet. You can still end it now."
                                    Visibility="{Binding ViewModel.IsBeforeEndDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Next year -->
                <ui:Card Visibility="{Binding ViewModel.IsNextYearStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                        <ui:TextBlock FontTypography="BodyStrong" Text="Next school year"/>
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Margin="0,8,0,4" Text="Label"/>
                        <ui:TextBox AutomationProperties.Name="Label of the next school year"
                                    IsReadOnly="{Binding ViewModel.IsNextYearCreated}"
                                    Text="{Binding ViewModel.NextYearLabel, UpdateSourceTrigger=PropertyChanged}"/>
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Margin="0,12,0,4" Text="First day"/>
                        <DatePicker AutomationProperties.Name="First day of the next school year"
                                    IsEnabled="{Binding ViewModel.IsNextYearEditable}"
                                    SelectedDate="{Binding ViewModel.NextYearStart}"/>
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Margin="0,12,0,4" Text="Last day"/>
                        <DatePicker AutomationProperties.Name="Last day of the next school year"
                                    IsEnabled="{Binding ViewModel.IsNextYearEditable}"
                                    SelectedDate="{Binding ViewModel.NextYearEnd}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Classes -->
                <ui:Card Visibility="{Binding ViewModel.IsClassesStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Margin="0,0,0,8" Text="Decide what happens to each class"/>
                        <ItemsControl ItemsSource="{Binding ViewModel.Classes}"
                                      ItemTemplate="{StaticResource ClassRowTemplate}"
                                      KeyboardNavigation.TabNavigation="Continue"/>
                    </StackPanel>
                </ui:Card>

                <!-- Readiness -->
                <ui:Card Visibility="{Binding ViewModel.IsReadinessStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:InfoBar IsOpen="True"
                                    IsClosable="False"
                                    Severity="Error"
                                    Title="These must be fixed first"
                                    Message="The school year cannot be closed until the items below are fixed."
                                    Visibility="{Binding ViewModel.HasBlockingItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding ViewModel.BlockingItems}"
                                      ItemTemplate="{StaticResource ReadinessItemTemplate}"/>

                        <ui:InfoBar Margin="0,12,0,0"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="Please review"
                                    Message="The items below do not stop you from closing the school year."
                                    Visibility="{Binding ViewModel.HasWarningItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding ViewModel.WarningItems}"
                                      ItemTemplate="{StaticResource ReadinessItemTemplate}"/>
                        <CheckBox Margin="0,8,0,0"
                                  Content="I have reviewed these warnings."
                                  AutomationProperties.Name="I have reviewed these warnings"
                                  IsChecked="{Binding ViewModel.AreWarningsAcknowledged, Mode=TwoWay}"
                                  Visibility="{Binding ViewModel.HasWarningItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Nothing found. -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ViewModel.HasBlockingItems}" Value="False"/>
                                                <Condition Binding="{Binding ViewModel.HasWarningItems}" Value="False"/>
                                                <Condition Binding="{Binding ViewModel.IsBusy}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <ui:TextBlock FontTypography="Body"
                                          VerticalAlignment="Center"
                                          Text="Nothing is blocking the close and there are no warnings."/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Confirm -->
                <ui:Card Visibility="{Binding ViewModel.IsConfirmStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body"
                                      TextWrapping="Wrap"
                                      Text="{Binding ViewModel.SummaryText}"/>
                        <ui:InfoBar Margin="0,12,0,0"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="This cannot be undone"
                                    Message="Closing the school year cannot be undone. The old school year becomes read-only and can only be changed later by unlocking it temporarily."/>
                    </StackPanel>
                </ui:Card>

                <!-- Result -->
                <ui:Card Visibility="{Binding ViewModel.IsResultStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        <ui:TextBlock FontTypography="Body"
                                      TextWrapping="Wrap"
                                      Text="{Binding ViewModel.ResultText}"/>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </ScrollViewer>

        <!-- Action bar: one set of buttons per step. -->
        <Grid Grid.Row="3"
              Margin="0,12,0,0"
              Visibility="{Binding ViewModel.HasActiveYear, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsOverviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Content="End school year"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon CalendarCancel24}"
                           Command="{Binding ViewModel.StartCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsNextYearStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="0,0,8,0"
                           Content="Create next year"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon CalendarAdd24}"
                           Command="{Binding ViewModel.CreateNextYearCommand}"/>
                <ui:Button Content="Back"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding ViewModel.BackCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsClassesStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="0,0,8,0"
                           Content="Apply"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Checkmark24}"
                           ToolTip="Apply the choices for all classes that are still waiting"
                           Command="{Binding ViewModel.ApplyClassChoicesCommand}"/>
                <ui:Button Margin="0,0,8,0"
                           Content="Continue"
                           Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding ViewModel.ContinueToReadinessCommand}"/>
                <ui:Button Content="Back"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding ViewModel.BackCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsReadinessStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="0,0,8,0"
                           Content="Continue"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding ViewModel.ContinueToConfirmCommand}"/>
                <ui:Button Content="Back"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding ViewModel.BackCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsConfirmStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="0,0,8,0"
                           Content="Close school year and activate next"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon LockClosed24}"
                           Command="{Binding ViewModel.RunCloseCommand}"/>
                <ui:Button Content="Back"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding ViewModel.BackCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsResultStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Content="Go to classes"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon HatGraduation24}"
                           Command="{Binding ViewModel.GoToClassesCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
