<Page x:Class="NexGrades.App.Features.SchoolYears.SchoolYearPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ds="clr-namespace:NexGrades.App.DesignSystem"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:yearLock="clr-namespace:NexGrades.App.Core.YearLock"
      xmlns:loc="clr-namespace:NexGrades.App.Localization"
      xmlns:schoolYears="clr-namespace:NexGrades.App.Features.SchoolYears"
      d:DataContext="{d:DesignInstance schoolYears:SchoolYearPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="900"
      Title="{loc:Text SchoolYears_Page_Title}">

    <Page.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- One row of the readiness lists: the finding and, when it links somewhere, an Open button. -->
        <DataTemplate x:Key="ReadinessItemTemplate" DataType="{x:Type schoolYears:ReadinessItemRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              VerticalAlignment="Center"
                              Margin="{StaticResource Ng.Margin.InlineGap}"
                              FontTypography="Body"
                              TextWrapping="Wrap"
                              Text="{Binding Text}"/>
                <ContentControl Grid.Column="1" IsTabStop="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Target}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                <ui:Button Content="{loc:Text SchoolYears_Readiness_Open}"
                           Icon="{ui:SymbolIcon Open24}"
                           ToolTip="{loc:Text SchoolYears_Readiness_Open_Tooltip}"
                           AutomationProperties.Name="{loc:Text SchoolYears_Readiness_Open_Tooltip}"
                           Command="{Binding DataContext.ViewModel.OpenReadinessItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                           CommandParameter="{Binding}"/>
                </ContentControl>
            </Grid>
        </DataTemplate>

        <!-- One class of the classes step. -->
        <DataTemplate x:Key="ClassRowTemplate" DataType="{x:Type schoolYears:ClassChoiceRow}">
            <Border Margin="{StaticResource Ng.Margin.Related}"
                    Style="{StaticResource Ng.Surface.Item}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      FontTypography="BodyStrong"
                                      Text="{Binding Name}"/>
                        <ui:TextBlock Grid.Column="1"
                                      FontTypography="Caption"
                                      Appearance="Secondary"
                                      Text="{Binding CarryOverText}"
                                      Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>

                    <!-- Pending: the teacher decides. -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Margin="0,0,16,0"
                                         GroupName="{Binding GroupName}"
                                         Content="{loc:Text SchoolYears_Class_RollForward}"
                                         AutomationProperties.Name="{loc:Text SchoolYears_Class_RollForward_A11y}"
                                         IsChecked="{Binding IsRollForwardChosen, Mode=TwoWay}"/>
                            <RadioButton Content="{loc:Text SchoolYears_Class_Archive}"
                                         GroupName="{Binding GroupName}"
                                         AutomationProperties.Name="{loc:Text SchoolYears_Class_Archive_A11y}"
                                         IsChecked="{Binding IsArchiveChosen, Mode=TwoWay}"/>
                        </StackPanel>
                        <ds:FormPanel Margin="0,8,0,0"
                                    Style="{StaticResource Ng.FormPanel}"
                                    Visibility="{Binding IsRollForwardPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <HeaderedContentControl Header="{loc:Text SchoolYears_Class_NewName_Header}"
                                                    Margin="0"
                                                    Style="{StaticResource Ng.FormField}">
                                <StackPanel>
                                    <ui:TextBox Width="240"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="{loc:Text SchoolYears_Class_NewName_A11y}"
                                                MaxLength="{Binding MaxNameLength, Mode=OneTime}"
                                                Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <!-- Why this name cannot be used -->
                                    <ui:TextBlock Margin="0,4,0,0"
                                                  FontTypography="Caption"
                                                  Appearance="Secondary"
                                                  TextWrapping="Wrap"
                                                  Text="{Binding NewNameValidationMessage}"
                                                  Visibility="{Binding HasNewNameValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </HeaderedContentControl>
                        </ds:FormPanel>
                        <CheckBox Margin="0,8,0,0"
                                  Content="{loc:Text SchoolYears_Class_End}"
                                  AutomationProperties.Name="{loc:Text SchoolYears_Class_End}"
                                  ToolTip="{loc:Text SchoolYears_Class_End_Tooltip}"
                                  IsChecked="{Binding EndClassGroup, Mode=TwoWay}"
                                  Visibility="{Binding IsArchiveChosen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding HasFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="Warning24"
                                           Margin="{StaticResource Ng.Margin.InlineGap}"
                                           VerticalAlignment="Top"
                                           Style="{StaticResource Ng.Icon.Caution}"/>
                            <ui:TextBlock MaxWidth="560"
                                          FontTypography="Body"
                                          TextWrapping="Wrap"
                                          Text="{Binding FailedText}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Done: read-only. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsDone, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                       Margin="{StaticResource Ng.Margin.InlineGap}"
                                       Style="{StaticResource Ng.Icon.Success}"/>
                        <ui:TextBlock FontTypography="Body"
                                      Text="{Binding DoneText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One closed school year: label, close date, state and the button that changes it. -->
        <DataTemplate x:Key="ClosedYearRowTemplate" DataType="{x:Type yearLock:YearLockViewModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              VerticalAlignment="Center"
                              FontTypography="BodyStrong"
                              Text="{Binding Label}"/>
                <ui:TextBlock Grid.Column="1"
                              VerticalAlignment="Center"
                              FontTypography="Body"
                              Text="{Binding ClosedOnMessage}"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Ng.Margin.InlineGap}">
                    <ui:SymbolIcon Symbol="LockClosed24"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ui:TextBlock FontTypography="Body"
                                  Text="{loc:Text SchoolYears_Closed_Locked}"
                                  Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ui:SymbolIcon Symbol="LockOpen24"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ui:TextBlock FontTypography="Body"
                                  TextWrapping="Wrap"
                                  Text="{Binding UnlockedMessage}"
                                  Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <Grid Grid.Column="3">
                    <ui:Button Content="{loc:Text SchoolYears_Closed_Unlock}"
                               Icon="{ui:SymbolIcon LockOpen24}"
                               ToolTip="{loc:Text SchoolYears_Closed_Unlock_Tooltip}"
                               AutomationProperties.Name="{loc:Text SchoolYears_Closed_Unlock_A11y}"
                               Command="{Binding UnlockCommand}"
                               Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ui:Button Content="{loc:Text SchoolYears_Closed_Relock}"
                               Icon="{ui:SymbolIcon LockClosed24}"
                               ToolTip="{loc:Text SchoolYears_Closed_Relock_Tooltip}"
                               AutomationProperties.Name="{loc:Text SchoolYears_Closed_Relock_A11y}"
                               Command="{Binding RelockCommand}"
                               Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{loc:Text SchoolYears_Page_Title}"
                                Style="{StaticResource Ng.PageHeader}"/>

        <!-- Empty state: nothing to end. -->
        <StackPanel Grid.Row="1" Grid.RowSpan="3"
                    Margin="0,16,0,0"
                    Visibility="{Binding ViewModel.HasActiveYear, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <ui:InfoBar IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="{loc:Text SchoolYears_NoActiveYear_Title}"
                        Message="{loc:Text SchoolYears_NoActiveYear_Message}"/>
        </StackPanel>

        <!-- Step header. -->
        <StackPanel Grid.Row="1"
                    Margin="0,8,0,0"
                    Visibility="{Binding ViewModel.HasActiveYear, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="{loc:Text SchoolYears_Step_Overview}"
                          Visibility="{Binding ViewModel.IsOverviewStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="{loc:Text SchoolYears_Step_NextYear}"
                          Visibility="{Binding ViewModel.IsNextYearStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="{loc:Text SchoolYears_Step_Classes}"
                          Visibility="{Binding ViewModel.IsClassesStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="{loc:Text SchoolYears_Step_Readiness}"
                          Visibility="{Binding ViewModel.IsReadinessStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="{loc:Text SchoolYears_Step_Confirm}"
                          Visibility="{Binding ViewModel.IsConfirmStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock FontTypography="Subtitle"
                          Appearance="Secondary"
                          Text="{loc:Text SchoolYears_Step_Done}"
                          Visibility="{Binding ViewModel.IsResultStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Step content. -->
        <ScrollViewer Grid.Row="2"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ViewModel.HasActiveYear, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <ui:ProgressRing IsIndeterminate="True"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Panel.ZIndex="1"
                                 AutomationProperties.Name="{loc:Text SchoolYears_Loading_A11y}"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Overview: the active year, then the closed years -->
                <StackPanel Visibility="{Binding ViewModel.IsOverviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Card Style="{StaticResource Ng.Card}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="{loc:Text SchoolYears_Overview_Active_Header}"/>
                        <ui:TextBlock FontTypography="Subtitle" Margin="0,4,0,0" Text="{Binding ViewModel.ActiveYearLabel}"/>
                        <ui:TextBlock FontTypography="Body" Margin="0,8,0,0"
                                      Text="{Binding ViewModel.ActiveYearStart, StringFormat={loc:Text SchoolYears_Overview_Starts_Format}}"/>
                        <ui:TextBlock FontTypography="Body" Margin="0,4,0,0"
                                      Text="{Binding ViewModel.ActiveYearEnd, StringFormat={loc:Text SchoolYears_Overview_Ends_Format}}"/>
                        <ui:InfoBar Margin="0,16,0,0"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="{loc:Text SchoolYears_Overview_NotOver_Title}"
                                    Message="{loc:Text SchoolYears_Overview_NotOver_Message}"
                                    Visibility="{Binding ViewModel.IsBeforeEndDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </ui:Card>

                <!-- The Planned successor, once it exists. -->
                <ui:Card Style="{StaticResource Ng.Card}"
                         Visibility="{Binding ViewModel.IsNextYearCreated, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="{loc:Text SchoolYears_Overview_Planned_Header}"/>
                        <ui:TextBlock FontTypography="Subtitle" Margin="0,4,0,0" Text="{Binding ViewModel.NextYearLabel}"/>
                        <ui:TextBlock FontTypography="Body" Margin="0,8,0,0"
                                      Text="{Binding ViewModel.NextYearStart, StringFormat={loc:Text SchoolYears_Overview_Starts_Format}}"/>
                        <ui:TextBlock FontTypography="Body" Margin="0,4,0,0"
                                      Text="{Binding ViewModel.NextYearEnd, StringFormat={loc:Text SchoolYears_Overview_Ends_Format}}"/>
                        <ui:Button Margin="0,16,0,0"
                                   Content="{loc:Text SchoolYears_Overview_EditNextYear}"
                                   Icon="{ui:SymbolIcon Edit24}"
                                   ToolTip="{loc:Text SchoolYears_Overview_EditNextYear_Tooltip}"
                                   AutomationProperties.Name="{loc:Text SchoolYears_Overview_EditNextYear_Tooltip}"
                                   Command="{Binding ViewModel.EditNextYearCommand}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Closed school years: unlock or lock again. -->
                <HeaderedContentControl Header="{loc:Text SchoolYears_Closed_Header}"
                                        Margin="0"
                                        Style="{StaticResource Ng.Section}">
                    <StackPanel>
                        <ContentControl Content="{loc:Text SchoolYears_Closed_Empty}"
                                        Style="{StaticResource Ng.EmptyState}"
                                        Visibility="{Binding ViewModel.ClosedYears.ShowNoClosedYears, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ContentControl Content="{loc:Text SchoolYears_Closed_LoadFailed}"
                                        Style="{StaticResource Ng.EmptyState}"
                                        Visibility="{Binding ViewModel.ClosedYears.LoadFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl AutomationProperties.Name="{loc:Text SchoolYears_Closed_Header}"
                                      ItemsSource="{Binding ViewModel.ClosedYears.Years}"
                                      ItemTemplate="{StaticResource ClosedYearRowTemplate}"
                                      KeyboardNavigation.TabNavigation="Continue"/>
                    </StackPanel>
                </HeaderedContentControl>
                </StackPanel>

                <!-- Next year -->
                <ui:Card Style="{StaticResource Ng.Card}" Visibility="{Binding ViewModel.IsNextYearStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ds:FormPanel Style="{StaticResource Ng.FormPanel}">
                        <ui:TextBlock FontTypography="BodyStrong"
                                      Margin="{StaticResource Ng.Margin.Related}"
                                      Text="{loc:Text SchoolYears_NextYear_Header}"/>
                        <HeaderedContentControl Header="{loc:Text SchoolYears_NextYear_Label_Header}" Style="{StaticResource Ng.FormField}">
                            <ui:TextBox AutomationProperties.Name="{loc:Text SchoolYears_NextYear_Label_A11y}"
                                        Text="{Binding ViewModel.NextYearLabel, UpdateSourceTrigger=PropertyChanged}"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{loc:Text SchoolYears_NextYear_First_Header}" Style="{StaticResource Ng.FormField}">
                            <DatePicker AutomationProperties.Name="{loc:Text SchoolYears_NextYear_First_A11y}"
                                        SelectedDate="{Binding ViewModel.NextYearStart}"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{loc:Text SchoolYears_NextYear_Last_Header}" Margin="0" Style="{StaticResource Ng.FormField}">
                            <DatePicker AutomationProperties.Name="{loc:Text SchoolYears_NextYear_Last_A11y}"
                                        SelectedDate="{Binding ViewModel.NextYearEnd}"/>
                        </HeaderedContentControl>
                        <ui:TextBlock Margin="{StaticResource Ng.Margin.Block}"
                                      FontTypography="Caption"
                                      Appearance="Secondary"
                                      TextWrapping="Wrap"
                                      Text="{loc:Text SchoolYears_NextYear_Planned_Hint}"
                                      Visibility="{Binding ViewModel.IsNextYearCreated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ui:TextBlock Margin="{StaticResource Ng.Margin.Block}"
                                      FontTypography="Caption"
                                      Appearance="Secondary"
                                      TextWrapping="Wrap"
                                      Text="{Binding ViewModel.NextYearValidationMessage}"
                                      Visibility="{Binding ViewModel.HasNextYearValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </ds:FormPanel>
                </ui:Card>

                <!-- Classes -->
                <ui:Card Style="{StaticResource Ng.Card}" Visibility="{Binding ViewModel.IsClassesStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Margin="{StaticResource Ng.Margin.Related}" Text="{loc:Text SchoolYears_Classes_Header}"/>
                        <ItemsControl ItemsSource="{Binding ViewModel.Classes}"
                                      ItemTemplate="{StaticResource ClassRowTemplate}"
                                      KeyboardNavigation.TabNavigation="Continue"/>
                    </StackPanel>
                </ui:Card>

                <!-- Readiness -->
                <ui:Card Style="{StaticResource Ng.Card}" Visibility="{Binding ViewModel.IsReadinessStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:InfoBar IsOpen="True"
                                    IsClosable="False"
                                    Severity="Error"
                                    Title="{loc:Text SchoolYears_Readiness_Blocking_Title}"
                                    Message="{loc:Text SchoolYears_Readiness_Blocking_Message}"
                                    Visibility="{Binding ViewModel.HasBlockingItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding ViewModel.BlockingItems}"
                                      ItemTemplate="{StaticResource ReadinessItemTemplate}"/>

                        <ui:InfoBar Margin="0,16,0,0"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="{loc:Text SchoolYears_Readiness_Warning_Title}"
                                    Message="{loc:Text SchoolYears_Readiness_Warning_Message}"
                                    Visibility="{Binding ViewModel.HasWarningItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding ViewModel.WarningItems}"
                                      ItemTemplate="{StaticResource ReadinessItemTemplate}"/>
                        <CheckBox Margin="0,8,0,0"
                                  Content="{loc:Text SchoolYears_Readiness_Acknowledge}"
                                  AutomationProperties.Name="{loc:Text SchoolYears_Readiness_Acknowledge}"
                                  IsChecked="{Binding ViewModel.AreWarningsAcknowledged, Mode=TwoWay}"
                                  Visibility="{Binding ViewModel.HasWarningItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Nothing found. -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ViewModel.HasBlockingItems}" Value="False"/>
                                                <Condition Binding="{Binding ViewModel.HasWarningItems}" Value="False"/>
                                                <Condition Binding="{Binding ViewModel.IsBusy}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           Margin="{StaticResource Ng.Margin.InlineGap}"
                                           Style="{StaticResource Ng.Icon.Success}"/>
                            <ui:TextBlock FontTypography="Body"
                                          VerticalAlignment="Center"
                                          Text="{loc:Text SchoolYears_Readiness_AllClear}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Confirm -->
                <ui:Card Style="{StaticResource Ng.Card}" Visibility="{Binding ViewModel.IsConfirmStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body"
                                      TextWrapping="Wrap"
                                      Text="{Binding ViewModel.SummaryText}"/>
                        <ui:InfoBar Margin="0,16,0,0"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="{loc:Text SchoolYears_Confirm_Title}"
                                    Message="{loc:Text SchoolYears_Confirm_Message}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Result -->
                <ui:Card Style="{StaticResource Ng.Card}" Visibility="{Binding ViewModel.IsResultStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                       Margin="{StaticResource Ng.Margin.InlineGap}"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource Ng.Icon.Success}"/>
                        <ui:TextBlock FontTypography="Body"
                                      TextWrapping="Wrap"
                                      Text="{Binding ViewModel.ResultText}"/>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </ScrollViewer>

        <!-- Action bar: one set of buttons per step. -->
        <Grid Grid.Row="3"
              Visibility="{Binding ViewModel.HasActiveYear, Converter={StaticResource BooleanToVisibilityConverter}}">
            <WrapPanel Style="{StaticResource Ng.ActionBar}"
                        Margin="0,16,0,0"
                        Visibility="{Binding ViewModel.IsOverviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text SchoolYears_Action_EndYear}"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon CalendarCancel24}"
                           Command="{Binding ViewModel.StartCommand}"/>
            </WrapPanel>

            <WrapPanel Style="{StaticResource Ng.ActionBar}"
                        Margin="0,16,0,0"
                        Visibility="{Binding ViewModel.IsNextYearStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text SchoolYears_Action_CreateNextYear}"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon CalendarAdd24}"
                           Command="{Binding ViewModel.CreateNextYearCommand}"
                           Visibility="{Binding ViewModel.IsNextYearCreated, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text Common_Save}"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon Save24}"
                           Command="{Binding ViewModel.SaveNextYearCommand}"
                           Visibility="{Binding ViewModel.IsNextYearCreated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text SchoolYears_Action_Continue}"
                           Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding ViewModel.ContinueToClassesCommand}"
                           Visibility="{Binding ViewModel.IsNextYearCreated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text Common_Back}"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding ViewModel.BackCommand}"/>
            </WrapPanel>

            <WrapPanel Style="{StaticResource Ng.ActionBar}"
                        Margin="0,16,0,0"
                        Visibility="{Binding ViewModel.IsClassesStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text SchoolYears_Action_Apply}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Checkmark24}"
                           ToolTip="{loc:Text SchoolYears_Action_Apply_Tooltip}"
                           Command="{Binding ViewModel.ApplyClassChoicesCommand}"/>
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text SchoolYears_Action_Continue}"
                           Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding ViewModel.ContinueToReadinessCommand}"/>
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text Common_Back}"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding ViewModel.BackCommand}"/>
            </WrapPanel>

            <WrapPanel Style="{StaticResource Ng.ActionBar}"
                        Margin="0,16,0,0"
                        Visibility="{Binding ViewModel.IsReadinessStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text SchoolYears_Action_Continue}"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding ViewModel.ContinueToConfirmCommand}"/>
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text Common_Back}"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding ViewModel.BackCommand}"/>
            </WrapPanel>

            <WrapPanel Style="{StaticResource Ng.ActionBar}"
                        Margin="0,16,0,0"
                        Visibility="{Binding ViewModel.IsConfirmStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text SchoolYears_Action_Close}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon LockClosed24}"
                           Command="{Binding ViewModel.RunCloseCommand}"/>
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text Common_Back}"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding ViewModel.BackCommand}"/>
            </WrapPanel>

            <WrapPanel Style="{StaticResource Ng.ActionBar}"
                        Margin="0,16,0,0"
                        Visibility="{Binding ViewModel.IsResultStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                           Content="{loc:Text SchoolYears_Action_GoToClasses}"
                           Appearance="Primary"
                           IsDefault="True"
                           Icon="{ui:SymbolIcon HatGraduation24}"
                           Command="{Binding ViewModel.GoToClassesCommand}"/>
            </WrapPanel>
