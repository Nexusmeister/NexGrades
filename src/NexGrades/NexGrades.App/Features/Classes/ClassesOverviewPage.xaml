<Page x:Class="NexGrades.App.Features.Classes.ClassesOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:interactivity="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:classes="clr-namespace:NexGrades.App.Features.Classes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance classes:ClassesOverviewPage, IsDesignTimeCreatable=False}"
      Title="Classes">

    <interactivity:Interaction.Triggers>
        <interactivity:EventTrigger EventName="Loaded">
            <interactivity:InvokeCommandAction Command="{Binding ViewModel.LoadClassesCommand}"/>
        </interactivity:EventTrigger>
    </interactivity:Interaction.Triggers>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="Classes"
                                Style="{StaticResource Ng.PageHeader}" />

        <WrapPanel Grid.Row="1" Style="{StaticResource Ng.ActionBar}">
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}" Appearance="Primary"
                       Content="Add class"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding ViewModel.AddClassCommand}" />
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                       Content="Edit class"
                       Icon="{ui:SymbolIcon Edit24}"
                       Command="{Binding ViewModel.EditClassCommand}" />
        </WrapPanel>

        <ContentControl Grid.Row="2"
                        Content="No classes yet. Use Add class to create one."
                        Tag="{Binding ViewModel.Classes}"
                        Style="{StaticResource Ng.EmptyState.WhenNoItems}" />

        <ui:DataGrid Grid.Row="3"
                     Style="{StaticResource Ng.DataGrid}"
                     ItemsSource="{Binding ViewModel.Classes}"
                     SelectedItem="{Binding ViewModel.SelectedClass}">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Cohort" Binding="{Binding CohortLabel}" />
                <DataGridTextColumn Header="Students" Binding="{Binding StudentCount}"
                                    ElementStyle="{StaticResource Ng.DataGridText.Numeric}" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
