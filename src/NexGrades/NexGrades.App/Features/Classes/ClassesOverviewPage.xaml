<Page x:Class="NexGrades.App.Features.Classes.ClassesOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:interactivity="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="clr-namespace:NexGrades.App.Localization"
      xmlns:classes="clr-namespace:NexGrades.App.Features.Classes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance classes:ClassesOverviewPage, IsDesignTimeCreatable=False}"
      Title="{loc:Text Classes_Overview_Title}">

    <interactivity:Interaction.Triggers>
        <interactivity:EventTrigger EventName="Loaded">
            <interactivity:InvokeCommandAction Command="{Binding ViewModel.LoadClassesCommand}"/>
        </interactivity:EventTrigger>
    </interactivity:Interaction.Triggers>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Year label followed by its localized status, e.g. "2026/27 (Active)". -->
            <DataTemplate x:Key="SchoolYearChoiceTemplate">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Margin="8,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Planned">
                                        <Setter Property="Text" Value="{loc:Text Classes_Overview_Year_Planned}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                        <Setter Property="Text" Value="{loc:Text Classes_Overview_Year_Active}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Closed">
                                        <Setter Property="Text" Value="{loc:Text Classes_Overview_Year_Closed}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{loc:Text Classes_Overview_Title}"
                                Style="{StaticResource Ng.PageHeader}" />

        <WrapPanel Grid.Row="1" Style="{StaticResource Ng.ActionBar}">
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}" Appearance="Primary"
                       Content="{loc:Text Classes_Overview_Add}"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding ViewModel.AddClassCommand}" />
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                       Content="{loc:Text Classes_Overview_Edit}"
                       Icon="{ui:SymbolIcon Edit24}"
                       Command="{Binding ViewModel.EditClassCommand}" />
            <HeaderedContentControl Header="{loc:Text Classes_Overview_SchoolYear}"
                                    Margin="{StaticResource Ng.Margin.ActionItem}"
                                    Style="{StaticResource Ng.FormField}">
                <ComboBox MinWidth="200"
                          AutomationProperties.Name="{loc:Text Classes_Overview_SchoolYear}"
                          ItemsSource="{Binding ViewModel.Years}"
                          SelectedItem="{Binding ViewModel.SelectedYear, Mode=TwoWay}"
                          ItemTemplate="{StaticResource SchoolYearChoiceTemplate}" />
            </HeaderedContentControl>
            <ui:ToggleSwitch Margin="{StaticResource Ng.Margin.ActionItem}"
                             VerticalAlignment="Center"
                             Content="{loc:Text Classes_Overview_ShowInactive}"
                             IsChecked="{Binding ViewModel.ShowInactiveClasses, Mode=TwoWay}" />
        </WrapPanel>

        <ContentControl Grid.Row="2"
                        Content="{loc:Text Classes_Overview_Empty}"
                        Tag="{Binding ViewModel.Classes}"
                        Style="{StaticResource Ng.EmptyState.WhenNoItems}" />

        <ui:DataGrid Grid.Row="3"
                     Style="{StaticResource Ng.DataGrid}"
                     ItemsSource="{Binding ViewModel.Classes}"
                     SelectedItem="{Binding ViewModel.SelectedClass}">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Text Classes_Grid_Name_Header}" Binding="{Binding Name}" ElementStyle="{StaticResource Ng.DataGridText}" />
                <DataGridTextColumn Header="{loc:Text Classes_Overview_Cohort_Header}" Binding="{Binding CohortLabel}" ElementStyle="{StaticResource Ng.DataGridText}" />
                <DataGridTextColumn Header="{loc:Text Classes_Overview_Students_Header}" Binding="{Binding StudentCount}"
                                    ElementStyle="{StaticResource Ng.DataGridText.Numeric}" />
                <DataGridTemplateColumn Header="{loc:Text Classes_Overview_Status_Header}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Badge Margin="{StaticResource Ng.Margin.ActionItem}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Appearance="Secondary"
                                      Content="{Binding StatusText}"
                                      Visibility="{Binding HasStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
