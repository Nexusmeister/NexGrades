<Page x:Class="NexGrades.App.Features.Classes.ClassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ds="clr-namespace:NexGrades.App.DesignSystem"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="clr-namespace:NexGrades.App.Localization"
      xmlns:classes="clr-namespace:NexGrades.App.Features.Classes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance classes:ClassPage, IsDesignTimeCreatable=False}"
      Title="{loc:Text Classes_ClassPage_Title}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{Binding ViewModel.Title}"
                                Style="{StaticResource Ng.PageHeader}" />

        <WrapPanel Grid.Row="1" Style="{StaticResource Ng.ActionBar}">
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                       Appearance="Primary"
                       IsDefault="True"
                       Content="{loc:Text Common_Save}"
                       Icon="{ui:SymbolIcon Save24}"
                       Command="{Binding ViewModel.SaveClassCommand}" />
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                       IsCancel="True"
                       Content="{loc:Text Common_Cancel}"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding ViewModel.CancelCommand}" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ds:FormPanel Style="{StaticResource Ng.FormPanel}">
                    <HeaderedContentControl Header="{loc:Text Classes_ClassPage_Name_Header}"
                                            Margin="{StaticResource Ng.Margin.Related}"
                                            Style="{StaticResource Ng.FormField}">
                        <ui:TextBox ClearButtonEnabled="True"
                                    PlaceholderText="{loc:Text Classes_ClassPage_Name_Placeholder}"
                                    PlaceholderEnabled="True"
                                    AutomationProperties.Name="{loc:Text Classes_ClassPage_Name_Header}"
                                    MaxLength="{Binding ViewModel.MaxNameLength, Mode=OneTime}"
                                    Text="{Binding ViewModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </HeaderedContentControl>

                    <!-- Why Save is disabled -->
                    <ui:TextBlock Margin="{StaticResource Ng.Margin.Block}"
                                  FontTypography="Caption"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Text="{Binding ViewModel.ClassValidationMessage}"
                                  Visibility="{Binding ViewModel.HasClassValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </ds:FormPanel>

                <HeaderedContentControl Header="{loc:Text Classes_ClassPage_Students_Header}"
                                        Style="{StaticResource Ng.Section}"
                                        Visibility="{Binding ViewModel.IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ContentControl Content="{loc:Text Classes_ClassPage_Students_Empty}"
                                        Style="{StaticResource Ng.EmptyState}"
                                        Visibility="{Binding ViewModel.HasNoStudents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:DataGrid ItemsSource="{Binding ViewModel.ActiveStudents}"
                                     Style="{StaticResource Ng.DataGrid}"
                                     HorizontalAlignment="Left"
                                     MaxHeight="360"
                                     AutomationProperties.Name="{loc:Text Classes_ClassPage_Students_A11y}">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Text Classes_Grid_Name_Header}" Width="260" Binding="{Binding FullName}" ElementStyle="{StaticResource Ng.DataGridText}" />
                                <DataGridTextColumn Header="{loc:Text Classes_ClassPage_Joined_Header}" Width="160" Binding="{Binding Period}" ElementStyle="{StaticResource Ng.DataGridText}" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                        <StackPanel Visibility="{Binding ViewModel.HasLeftStudents, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="{loc:Text Classes_ClassPage_Left_Header}"
                                          Margin="0,16,0,8" />
                            <ui:DataGrid ItemsSource="{Binding ViewModel.LeftStudents}"
                                         Style="{StaticResource Ng.DataGrid}"
                                         HorizontalAlignment="Left"
                                         MaxHeight="240"
                                         AutomationProperties.Name="{loc:Text Classes_ClassPage_Left_A11y}">
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Text Classes_Grid_Name_Header}" Width="260" Binding="{Binding FullName}" ElementStyle="{StaticResource Ng.DataGridText}" />
                                    <DataGridTextColumn Header="{loc:Text Classes_ClassPage_Enrolled_Header}" Width="220" Binding="{Binding Period}" ElementStyle="{StaticResource Ng.DataGridText}" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl x:Name="SubjectsSection"
                                        Header="{loc:Text Classes_ClassPage_Subjects_Header}"
                                        Style="{StaticResource Ng.Section}"
                                        Visibility="{Binding ViewModel.IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ContentControl Content="{loc:Text Classes_ClassPage_Subjects_Empty}"
                                        Style="{StaticResource Ng.EmptyState}"
                                        Visibility="{Binding ViewModel.HasNoSubjects, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding ViewModel.Subjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{StaticResource Ng.Margin.Related}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      Margin="{StaticResource Ng.Margin.InlineGap}"
                                                      Text="{Binding SubjectName}" />
                                        <ui:Button Grid.Column="1"
                                                   Margin="{StaticResource Ng.Margin.InlineGap}"
                                                   Content="{loc:Text Classes_ClassPage_Grades}"
                                                   Icon="{ui:SymbolIcon Table24}"
                                                   ToolTip="{loc:Text Classes_ClassPage_Grades_Tooltip}"
                                                   Command="{Binding DataContext.ViewModel.OpenGradesCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Grid.Column="2"
                                                   Content="{loc:Text Classes_ClassPage_Export}"
                                                   Icon="{ui:SymbolIcon ArrowExportUp24}"
                                                   ToolTip="{loc:Text Classes_ClassPage_Export_Tooltip}"
                                                   Command="{Binding DataContext.ViewModel.ExportSubjectOverviewCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
