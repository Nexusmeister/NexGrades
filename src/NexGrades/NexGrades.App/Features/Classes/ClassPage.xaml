<Page x:Class="NexGrades.App.Features.Classes.ClassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:classes="clr-namespace:NexGrades.App.Features.Classes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance classes:ClassPage, IsDesignTimeCreatable=False}"
      Title="ClassPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <StackPanel Margin="5,0,5, 0" Orientation="Vertical">
        <ui:TextBlock FontTypography="Title" 
                      Text="{Binding ViewModel.Title}"
                      Appearance="Secondary"/>
        <StackPanel Margin="0,5" Orientation="Horizontal">
            <ui:Button 
                Margin="0,0,5,0" 
                Content="Save" 
                Icon="{ui:SymbolIcon Save28}"
                Command="{Binding ViewModel.SaveClassCommand}"/>
            <ui:Button 
                Margin="0,0,5,0" 
                Content="Cancel" 
                Icon="{ui:SymbolIcon Prohibited28}"
                Command="{Binding ViewModel.CancelCommand}"/>
        </StackPanel>

        <ui:TextBox ClearButtonEnabled="True" Text="{Binding ViewModel.Name}" PlaceholderText="ClassName"></ui:TextBox>

        <StackPanel Margin="0,16,0,0"
                    Visibility="{Binding ViewModel.IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:TextBlock FontTypography="Subtitle" Text="Students" Margin="0,0,0,8"/>
            <ui:TextBlock Text="No students are enrolled in this class."
                          Appearance="Secondary"
                          Visibility="{Binding ViewModel.HasNoStudents, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ListView ItemsSource="{Binding ViewModel.ActiveStudents}" MaxHeight="360">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding FullName}"/>
                        <GridViewColumn Header="Joined" Width="160" DisplayMemberBinding="{Binding Period}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Visibility="{Binding ViewModel.HasLeftStudents, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:TextBlock FontTypography="BodyStrong" Text="Left the class" Margin="0,16,0,8"/>
                <ListView ItemsSource="{Binding ViewModel.LeftStudents}" MaxHeight="240">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding FullName}"/>
                            <GridViewColumn Header="Enrolled" Width="220" DisplayMemberBinding="{Binding Period}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
