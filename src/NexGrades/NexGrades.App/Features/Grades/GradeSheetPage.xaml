<Page x:Class="NexGrades.App.Features.Grades.GradeSheetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:grades="clr-namespace:NexGrades.App.Features.Grades"
      xmlns:core="clr-namespace:NexGrades.App.Core"
      xmlns:yearLock="clr-namespace:NexGrades.App.Core.YearLock"
      xmlns:services="clr-namespace:NexGrades.Domain.Services;assembly=NexGrades.Domain"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      d:DataContext="{d:DesignInstance grades:GradeSheetPage, IsDesignTimeCreatable=False}"
      Title="GradeSheetPage">

    <!-- Page-local, like ClassPage: the page must build without App.xaml's resources (see NexGrades.App.Tests). -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- Style of every grade cell. DataGridColumnsBehavior derives from it and adds Tag (the cell's visual state)
             and a tooltip with its explanation. Marks are never colour only: a symbol and a border or fill change
             come with every colour, and the tooltip states the reason in words. -->
        <Style x:Key="GradeSheetGradeCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <ui:SymbolIcon x:Name="Mark"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Symbol="Info16"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.NotEnrolled}">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="Subtract16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.Exempt}">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="Prohibited16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.AssessmentVoided}">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="DismissCircle16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.Voided}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="ArrowUndo16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- A final grade the teacher typed over the proposal: bold text and a pin, not colour. -->
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.Override}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="Pin16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.Error}">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="ErrorCircle16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Student name, other grades and averages. The student's row note (exempt, left) is a tooltip, and
             italic text marks such a row, so the mark is not colour only. -->
        <Style x:Key="GradeSheetReadOnlyCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding StatusText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRowEnabled}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLeft}" Value="True">
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Column header: bucket, title, date, and the assessment actions (edit, void, restore). The same actions
             are in the "Assessments" card below the grid, which is the keyboard path. -->
        <DataTemplate x:Key="GradeSheetColumnHeaderTemplate" DataType="{x:Type grades:GradeSheetColumn}">
            <StackPanel MinWidth="72">
                <ui:TextBlock FontTypography="Caption"
                              Appearance="Secondary"
                              TextTrimming="CharacterEllipsis"
                              Text="{Binding BucketName}"/>
                <ui:TextBlock FontTypography="BodyStrong"
                              TextTrimming="CharacterEllipsis"
                              Text="{Binding Header}"/>
                <ui:TextBlock FontTypography="Caption"
                              Appearance="Secondary"
                              Text="{Binding SubHeader}"/>
                <ui:TextBlock FontTypography="Caption"
                              Appearance="Secondary"
                              TextWrapping="Wrap"
                              MaxWidth="120"
                              Text="Type 1–6 to override">
                    <ui:TextBlock.Style>
                        <Style TargetType="ui:TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static grades:GradeSheetColumnKind.FinalGrade}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:TextBlock.Style>
                </ui:TextBlock>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static grades:GradeSheetColumnKind.Assessment}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsVoided, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="DismissCircle16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <ui:TextBlock FontTypography="Caption" Text="Voided" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ui:Button Appearance="Transparent"
                                   Padding="4"
                                   Icon="{ui:SymbolIcon ArrowUndo16}"
                                   ToolTip="Restore this assessment"
                                   AutomationProperties.Name="Restore assessment"
                                   Command="{Binding DataContext.ViewModel.RestoreAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:Button Appearance="Transparent"
                                   Padding="4"
                                   Margin="0,0,4,0"
                                   Icon="{ui:SymbolIcon Edit16}"
                                   ToolTip="Edit this assessment's title and date"
                                   AutomationProperties.Name="Edit assessment"
                                   Command="{Binding DataContext.ViewModel.BeginEditAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"/>
                        <ui:Button Appearance="Transparent"
                                   Padding="4"
                                   Icon="{ui:SymbolIcon DismissCircle16}"
                                   ToolTip="Void this assessment. It can be restored later."
                                   AutomationProperties.Name="Void assessment"
                                   Command="{Binding DataContext.ViewModel.VoidAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SectionCardStyle" TargetType="ui:Card">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- A form card that shows only while its flag is true. -->
        <Style x:Key="ConditionalCardStyle" TargetType="ui:Card" BasedOn="{StaticResource SectionCardStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <ui:TextBlock FontTypography="Title"
                          Appearance="Secondary"
                          TextTrimming="CharacterEllipsis"
                          Text="{Binding ViewModel.Title}"/>
            <ui:TextBlock FontTypography="Caption"
                          Appearance="Secondary"
                          Text="{Binding ViewModel.SchoolYearLabel, StringFormat='School year {0}'}"
                          Visibility="{Binding ViewModel.HasSheet, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Action bar -->
        <StackPanel Grid.Row="1" Margin="0,12" Orientation="Horizontal">
            <ui:Button Margin="0,0,16,0"
                       Content="Back"
                       Icon="{ui:SymbolIcon ArrowLeft24}"
                       ToolTip="Go back to the class"
                       AutomationProperties.Name="Back to the class"
                       Command="{Binding ViewModel.BackCommand}"/>
            <ui:ToggleSwitch Margin="0,0,16,0"
                             VerticalAlignment="Center"
                             Content="Show voided grades"
                             ToolTip="Also show voided grades and assessments so they can be restored"
                             AutomationProperties.Name="Show voided grades"
                             IsChecked="{Binding ViewModel.ShowVoidedGrades}"
                             Visibility="{Binding ViewModel.HasSheet, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:ProgressRing IsIndeterminate="True"
                             Width="24"
                             Height="24"
                             AutomationProperties.Name="Loading the grade sheet"
                             Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Year state -->
        <yearLock:YearLockBar Grid.Row="2"
                              Margin="0,0,0,12"
                              DataContext="{Binding ViewModel.YearLock}"/>

        <!-- Empty or error state, shown only when the load finished without a sheet -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ViewModel.IsEmptyState}" Value="True"/>
                                <Condition Binding="{Binding ViewModel.IsLoading}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ui:InfoBar IsClosable="False"
                        IsOpen="True"
                        Severity="Informational"
                        Title="Grade sheet not available"
                        Message="{Binding ViewModel.EmptyStateMessage}"/>
        </Grid>

        <!-- Sheet -->
        <Grid Grid.Row="4"
              Visibility="{Binding ViewModel.HasSheet, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:DataGrid AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         CanUserReorderColumns="False"
                         CanUserResizeRows="False"
                         CanUserSortColumns="False"
                         SelectionMode="Single"
                         SelectionUnit="Cell"
                         HeadersVisibility="Column"
                         GridLinesVisibility="None"
                         EnableRowVirtualization="True"
                         MinHeight="160"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Grade sheet. Type a grade such as 2- into a cell, press Enter to save, Escape to cancel. The last columns show the proposed final grade and the final grade, which you can type over the proposal."
                         ItemsSource="{Binding ViewModel.Rows}"
                         grades:DataGridColumnsBehavior.Columns="{Binding ViewModel.Columns}"
                         grades:DataGridColumnsBehavior.SelectedCell="{Binding ViewModel.SelectedCell, Mode=OneWayToSource}"/>

            <ui:TextBlock HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Appearance="Secondary"
                          TextWrapping="Wrap"
                          Text="There are no students in this class yet."
                          IsHitTestVisible="False">
                <ui:TextBlock.Style>
                    <Style TargetType="ui:TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:TextBlock.Style>
            </ui:TextBlock>
        </Grid>

        <!-- Details and assessments. The cards wrap and the panel scrolls, so nothing is clipped at 900 x 600. -->
        <Expander Grid.Row="5"
                  Margin="0,12,0,0"
                  IsExpanded="True"
                  Header="Grade details and assessments"
                  AutomationProperties.Name="Grade details and assessments"
                  Visibility="{Binding ViewModel.HasSheet, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer MaxHeight="220"
                          Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel>

                    <!-- Selected grade -->
                    <ui:Card Style="{StaticResource ConditionalCardStyle}"
                             Visibility="{Binding ViewModel.HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel IsEnabled="{Binding ViewModel.IsWritable}">
                            <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Grade details"/>
                            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Date"/>
                            <DatePicker Margin="0,0,0,8"
                                        AutomationProperties.Name="Date of the grade"
                                        SelectedDate="{Binding ViewModel.DetailDate}"/>
                            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Label"/>
                            <ui:TextBox Margin="0,0,0,8"
                                        MaxLength="{x:Static services:GradeService.MaxLabelLength}"
                                        AutomationProperties.Name="Label of the grade"
                                        PlaceholderText="For example Vocabulary test"
                                        Text="{Binding ViewModel.DetailLabel, UpdateSourceTrigger=PropertyChanged}"/>
                            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Comment"/>
                            <ui:TextBox Margin="0,0,0,8"
                                        MinHeight="56"
                                        MaxHeight="96"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        MaxLength="{x:Static services:GradeService.MaxCommentLength}"
                                        AutomationProperties.Name="Comment on the grade"
                                        Text="{Binding ViewModel.DetailComment, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0"
                                           Content="Save details"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Save24}"
                                           Command="{Binding ViewModel.SaveDetailCommand}"/>
                                <ui:Button Content="Discard"
                                           Icon="{ui:SymbolIcon Dismiss24}"
                                           ToolTip="Discard the changes and show the saved details"
                                           Command="{Binding ViewModel.DiscardDetailCommand}"/>
                            </StackPanel>
                            <ui:Button Margin="0,8,0,0"
                                       Content="Void grade"
                                       Icon="{ui:SymbolIcon DismissCircle24}"
                                       ToolTip="Void this grade. It stops counting in the averages and can be restored later."
                                       AutomationProperties.Name="Void grade"
                                       Command="{Binding ViewModel.VoidGradeCommand}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Selected voided grade -->
                    <ui:Card>
                        <ui:Card.Style>
                            <Style TargetType="ui:Card" BasedOn="{StaticResource ConditionalCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.SelectedCell.IsVoidedGrade}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Card.Style>
                        <StackPanel>
                            <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Voided grade"/>
                            <ui:TextBlock Margin="0,0,0,8"
                                          Appearance="Secondary"
                                          TextWrapping="Wrap"
                                          Text="This grade is voided and does not count in the averages. Restore it to use it again."/>
                            <ui:Button Content="Restore grade"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowUndo24}"
                                       Command="{Binding ViewModel.RestoreGradeCommand}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Edit assessment -->
                    <ui:Card Style="{StaticResource ConditionalCardStyle}"
                             Visibility="{Binding ViewModel.IsEditingAssessment, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Edit assessment"/>
                            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Title"/>
                            <ui:TextBox Margin="0,0,0,8"
                                        MaxLength="{x:Static services:AssessmentService.MaxTitleLength}"
                                        AutomationProperties.Name="Assessment title"
                                        Text="{Binding ViewModel.EditAssessmentTitle, UpdateSourceTrigger=PropertyChanged}"/>
                            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Date"/>
                            <DatePicker Margin="0,0,0,8"
                                        AutomationProperties.Name="Assessment date"
                                        SelectedDate="{Binding ViewModel.EditAssessmentDate}"/>
                            <ui:TextBlock Margin="0,0,0,8"
                                          FontTypography="Caption"
                                          Appearance="Secondary"
                                          TextWrapping="Wrap"
                                          Text="Enter a title, and a date inside the school year."/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0"
                                           Content="Save assessment"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Save24}"
                                           Command="{Binding ViewModel.SaveAssessmentEditCommand}"/>
                                <ui:Button Content="Cancel"
                                           Icon="{ui:SymbolIcon Prohibited24}"
                                           Command="{Binding ViewModel.CancelEditAssessmentCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Add assessment -->
                    <ui:Card Style="{StaticResource SectionCardStyle}">
                        <StackPanel IsEnabled="{Binding ViewModel.IsWritable}">
                            <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Add assessment"/>
                            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Bucket"/>
                            <ComboBox Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Bucket of the new assessment"
                                      ItemsSource="{Binding ViewModel.Buckets}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding ViewModel.NewAssessmentBucket}"/>
                            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Title"/>
                            <ui:TextBox Margin="0,0,0,8"
                                        MaxLength="{x:Static services:AssessmentService.MaxTitleLength}"
                                        AutomationProperties.Name="Title of the new assessment"
                                        PlaceholderText="For example Test 1"
                                        Text="{Binding ViewModel.NewAssessmentTitle, UpdateSourceTrigger=PropertyChanged}"/>
                            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="Date"/>
                            <DatePicker Margin="0,0,0,8"
                                        AutomationProperties.Name="Date of the new assessment"
                                        SelectedDate="{Binding ViewModel.NewAssessmentDate}"/>
                            <ui:TextBlock Margin="0,0,0,8"
                                          FontTypography="Caption"
                                          Appearance="Secondary"
                                          TextWrapping="Wrap"
                                          Text="Choose a bucket, enter a title, and pick a date inside the school year."/>
                            <ui:Button Content="Add assessment"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Command="{Binding ViewModel.AddAssessmentCommand}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Assessments: the keyboard path to the actions in the column headers -->
                    <ui:Card Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Text="Assessments"/>
                            <ItemsControl ItemsSource="{Binding ViewModel.Columns}"
                                          KeyboardNavigation.TabNavigation="Continue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type grades:GradeSheetColumn}">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static grades:GradeSheetColumnKind.Assessment}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <ui:TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Header}"/>
                                                <ui:TextBlock FontTypography="Caption"
                                                              Appearance="Secondary"
                                                              TextTrimming="CharacterEllipsis"
                                                              Text="{Binding BucketName}"/>
                                                <ui:TextBlock FontTypography="Caption"
                                                              Appearance="Secondary"
                                                              Text="{Binding SubHeader}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Margin="0,0,4,0"
                                                           Icon="{ui:SymbolIcon Edit24}"
                                                           ToolTip="Edit this assessment's title and date"
                                                           AutomationProperties.Name="Edit assessment"
                                                           Command="{Binding DataContext.ViewModel.BeginEditAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsVoided, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                <ui:Button Icon="{ui:SymbolIcon DismissCircle24}"
                                                           ToolTip="Void this assessment. It can be restored later."
                                                           AutomationProperties.Name="Void assessment"
                                                           Command="{Binding DataContext.ViewModel.VoidAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsVoided, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}"
                                                           ToolTip="Restore this assessment"
                                                           AutomationProperties.Name="Restore assessment"
                                                           Command="{Binding DataContext.ViewModel.RestoreAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsVoided, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>
                </WrapPanel>
            </ScrollViewer>
        </Expander>
    </Grid>
</Page>
