<Page x:Class="NexGrades.App.Features.Grades.GradeSheetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:grades="clr-namespace:NexGrades.App.Features.Grades"
      xmlns:core="clr-namespace:NexGrades.App.Core"
      xmlns:yearLock="clr-namespace:NexGrades.App.Core.YearLock"
      xmlns:loc="clr-namespace:NexGrades.App.Localization"
      xmlns:services="clr-namespace:NexGrades.Domain.Services;assembly=NexGrades.Domain"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      d:DataContext="{d:DesignInstance grades:GradeSheetPage, IsDesignTimeCreatable=False}"
      Title="{loc:Text Grades_GradeSheet_Title}">

    <Page.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- Shared by both cell styles: the design-system cell padding and row height. -->
        <Style x:Key="GradeSheetCellBase" TargetType="DataGridCell">
            <Setter Property="Padding" Value="{StaticResource Ng.Padding.Cell}"/>
            <Setter Property="MinHeight" Value="{StaticResource Ng.Size.RowHeight}"/>
        </Style>

        <!-- The displayed text of every cell. DataGridTextColumn applies its own text margin otherwise, which is what made
             the rows about 50 px high; the cell padding above is the only spacing. -->
        <Style x:Key="GradeSheetCellTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style of every grade cell. DataGridColumnsBehavior derives from it and adds Tag (the cell's visual state)
             and a tooltip with its explanation. Marks are never colour only: a symbol and a border or fill change
             come with every colour, and the tooltip states the reason in words. -->
        <Style x:Key="GradeSheetGradeCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GradeSheetCellBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <ui:SymbolIcon x:Name="Mark"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Symbol="Info16"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.NotEnrolled}">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="Subtract16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.Exempt}">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="Prohibited16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.AssessmentVoided}">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="DismissCircle16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.Voided}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="ArrowUndo16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- A final grade the teacher typed over the proposal: bold text and a pin, not colour. -->
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.Override}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="Pin16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static grades:GradeCellVisualState.Error}">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                <Setter TargetName="Mark" Property="Symbol" Value="ErrorCircle16"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Student name, other grades and averages. The student's row note (exempt, left) is a tooltip, and
             italic text marks such a row, so the mark is not colour only. -->
        <Style x:Key="GradeSheetReadOnlyCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GradeSheetCellBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding StatusText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRowEnabled}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLeft}" Value="True">
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Visible only for assessment columns (not student, average or final grade columns). -->
        <Style x:Key="AssessmentColumnsOnlyStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static grades:GradeSheetColumnKind.Assessment}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Column header: bucket, title, date, and the assessment actions (edit, void, restore). The same actions
             are in the "Assessments" card below the grid, which is the keyboard path. -->
        <DataTemplate x:Key="GradeSheetColumnHeaderTemplate" DataType="{x:Type grades:GradeSheetColumn}">
            <StackPanel MinWidth="72">
                <ui:TextBlock FontTypography="Caption"
                              Appearance="Secondary"
                              TextTrimming="CharacterEllipsis"
                              Text="{Binding BucketName}"/>
                <ui:TextBlock FontTypography="BodyStrong"
                              TextTrimming="CharacterEllipsis"
                              Text="{Binding Header}"/>
                <ui:TextBlock FontTypography="Caption"
                              Appearance="Secondary"
                              Text="{Binding SubHeader}"/>
                <ui:TextBlock FontTypography="Caption"
                              Appearance="Secondary"
                              TextWrapping="Wrap"
                              MaxWidth="120"
                              Text="{loc:Text Grades_GradeSheet_Header_FinalGradeHint}"
                              Visibility="{Binding IsFinalGrade, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" Style="{StaticResource AssessmentColumnsOnlyStyle}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsVoided, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="DismissCircle16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <ui:TextBlock FontTypography="Caption" Text="{loc:Text Grades_GradeSheet_Header_Voided}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ui:Button Appearance="Transparent"
                                   Padding="4"
                                   Icon="{ui:SymbolIcon ArrowUndo16}"
                                   ToolTip="{loc:Text Grades_Assessment_Restore_Tooltip}"
                                   AutomationProperties.Name="{loc:Text Grades_Assessment_Restore}"
                                   Command="{Binding DataContext.ViewModel.RestoreAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:Button Appearance="Transparent"
                                   Padding="4"
                                   Margin="0,0,4,0"
                                   Icon="{ui:SymbolIcon Edit16}"
                                   ToolTip="{loc:Text Grades_Assessment_Edit_Tooltip}"
                                   AutomationProperties.Name="{loc:Text Grades_EditAssessment_Header}"
                                   Command="{Binding DataContext.ViewModel.BeginEditAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"/>
                        <ui:Button Appearance="Transparent"
                                   Padding="4"
                                   Icon="{ui:SymbolIcon DismissCircle16}"
                                   ToolTip="{loc:Text Grades_Assessment_Void_Tooltip}"
                                   AutomationProperties.Name="{loc:Text Grades_Assessment_Void}"
                                   Command="{Binding DataContext.ViewModel.VoidAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SectionCardStyle" TargetType="ui:Card" BasedOn="{StaticResource Ng.Card.Tile}">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- A form card that shows only while its flag is true. -->
        <Style x:Key="ConditionalCardStyle" TargetType="ui:Card" BasedOn="{StaticResource SectionCardStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{Binding ViewModel.Title}"
                                Style="{StaticResource Ng.PageHeader}">
            <ui:TextBlock FontTypography="Body"
                          Appearance="Secondary"
                          Text="{Binding ViewModel.SchoolYearLabel, StringFormat={loc:Text Grades_GradeSheet_SchoolYear_Format}}"
                          Visibility="{Binding ViewModel.HasSheet, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </HeaderedContentControl>

        <WrapPanel Grid.Row="1" Style="{StaticResource Ng.ActionBar}">
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                       Content="{loc:Text Common_Back}"
                       Icon="{ui:SymbolIcon ArrowLeft24}"
                       ToolTip="{loc:Text Grades_GradeSheet_Back_Tooltip}"
                       AutomationProperties.Name="{loc:Text Grades_GradeSheet_Back_A11y}"
                       Command="{Binding ViewModel.BackCommand}"/>
            <ui:ToggleSwitch Margin="{StaticResource Ng.Margin.ActionItem}"
                             VerticalAlignment="Center"
                             Content="{loc:Text Grades_GradeSheet_ShowVoided}"
                             ToolTip="{loc:Text Grades_GradeSheet_ShowVoided_Tooltip}"
                             AutomationProperties.Name="{loc:Text Grades_GradeSheet_ShowVoided}"
                             IsChecked="{Binding ViewModel.ShowVoidedGrades}"
                             Visibility="{Binding ViewModel.HasSheet, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:ProgressRing IsIndeterminate="True"
                             Margin="{StaticResource Ng.Margin.ActionItem}"
                             Width="24"
                             Height="24"
                             AutomationProperties.Name="{loc:Text Grades_GradeSheet_Loading_A11y}"
                             Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </WrapPanel>

        <!-- Year state -->
        <yearLock:YearLockBar Grid.Row="2"
                              Margin="{StaticResource Ng.Margin.Related}"
                              DataContext="{Binding ViewModel.YearLock}"/>

        <!-- Empty or error state, shown only when the load finished without a sheet -->
        <Grid Grid.Row="3" Margin="{StaticResource Ng.Margin.Related}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ViewModel.IsEmptyState}" Value="True"/>
                                <Condition Binding="{Binding ViewModel.IsLoading}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ui:InfoBar IsClosable="False"
                        IsOpen="True"
                        Severity="Informational"
                        Title="{loc:Text Grades_GradeSheet_Unavailable_Title}"
                        Message="{Binding ViewModel.EmptyStateMessage}"/>
        </Grid>

        <!-- Sheet -->
        <Grid Grid.Row="4"
              Visibility="{Binding ViewModel.HasSheet, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:DataGrid x:Name="SheetGrid"
                         Style="{StaticResource Ng.DataGrid}"
                         IsReadOnly="False"
                         CanUserReorderColumns="False"
                         CanUserSortColumns="False"
                         SelectionUnit="Cell"
                         GridLinesVisibility="None"
                         Typography.NumeralAlignment="Tabular"
                         EnableRowVirtualization="True"
                         MinHeight="160"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{loc:Text Grades_GradeSheet_Grid_A11y}"
                         ItemsSource="{Binding ViewModel.Rows}"
                         grades:DataGridColumnsBehavior.Columns="{Binding ViewModel.Columns}"
                         grades:DataGridColumnsBehavior.SelectedCell="{Binding ViewModel.SelectedCell, Mode=OneWayToSource}"/>

            <ContentControl HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Content="{loc:Text Grades_GradeSheet_NoStudents}"
                            Style="{StaticResource Ng.EmptyState.WhenNoItems}"
                            Tag="{Binding ViewModel.Rows}"/>
        </Grid>

        <!-- Details and assessments. The cards wrap and the panel scrolls, so nothing is clipped at 900 x 600. -->
        <Expander Grid.Row="5"
                  Margin="0,16,0,0"
                  IsExpanded="True"
                  Header="{loc:Text Grades_GradeSheet_Details_Header}"
                  AutomationProperties.Name="{loc:Text Grades_GradeSheet_Details_Header}"
                  Visibility="{Binding ViewModel.HasSheet, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer MaxHeight="220"
                          Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel>

                    <!-- Selected grade -->
                    <ui:Card Style="{StaticResource ConditionalCardStyle}"
                             Visibility="{Binding ViewModel.HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel IsEnabled="{Binding ViewModel.IsWritable}">
                            <HeaderedContentControl Header="{loc:Text Grades_Detail_Header}"
                                                    Margin="{StaticResource Ng.Margin.Related}"
                                                    Style="{StaticResource Ng.Section}">
                                <StackPanel>
                                    <HeaderedContentControl Header="{loc:Text Grades_Date_Header}"
                                                            Margin="{StaticResource Ng.Margin.Related}"
                                                            Style="{StaticResource Ng.FormField}">
                                        <DatePicker AutomationProperties.Name="{loc:Text Grades_Detail_Date_A11y}"
                                                    SelectedDate="{Binding ViewModel.DetailDate}"/>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{loc:Text Grades_Detail_Label_Header}"
                                                            Margin="{StaticResource Ng.Margin.Related}"
                                                            Style="{StaticResource Ng.FormField}">
                                        <ui:TextBox MaxLength="{x:Static services:GradeService.MaxLabelLength}"
                                                    AutomationProperties.Name="{loc:Text Grades_Detail_Label_A11y}"
                                                    PlaceholderText="{loc:Text Grades_Detail_Label_Placeholder}"
                                                    Text="{Binding ViewModel.DetailLabel, UpdateSourceTrigger=PropertyChanged}"/>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{loc:Text Grades_Detail_Comment_Header}"
                                                            Margin="{StaticResource Ng.Margin.Related}"
                                                            Style="{StaticResource Ng.FormField}">
                                        <ui:TextBox Style="{StaticResource Ng.TextBox.Multiline}"
                                                    MaxLength="{x:Static services:GradeService.MaxCommentLength}"
                                                    AutomationProperties.Name="{loc:Text Grades_Detail_Comment_A11y}"
                                                    Text="{Binding ViewModel.DetailComment, UpdateSourceTrigger=PropertyChanged}"/>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </HeaderedContentControl>
                            <WrapPanel>
                                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                                           Content="{loc:Text Grades_Detail_Save}"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Save24}"
                                           Command="{Binding ViewModel.SaveDetailCommand}"/>
                                <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                                           Content="{loc:Text Grades_Detail_Discard}"
                                           Icon="{ui:SymbolIcon Dismiss24}"
                                           ToolTip="{loc:Text Grades_Detail_Discard_Tooltip}"
                                           Command="{Binding ViewModel.DiscardDetailCommand}"/>
                            </WrapPanel>
                            <ui:Button Content="{loc:Text Grades_Detail_Void}"
                                       Icon="{ui:SymbolIcon DismissCircle24}"
                                       ToolTip="{loc:Text Grades_Detail_Void_Tooltip}"
                                       AutomationProperties.Name="{loc:Text Grades_Detail_Void}"
                                       Command="{Binding ViewModel.VoidGradeCommand}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Selected voided grade -->
                    <ui:Card>
                        <ui:Card.Style>
                            <Style TargetType="ui:Card" BasedOn="{StaticResource ConditionalCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.SelectedCell.IsVoidedGrade}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Card.Style>
                        <HeaderedContentControl Header="{loc:Text Grades_Voided_Header}"
                                                Margin="0"
                                                Style="{StaticResource Ng.Section}">
                            <StackPanel>
                                <ui:TextBlock Margin="{StaticResource Ng.Margin.Related}"
                                              FontTypography="Body"
                                              Appearance="Secondary"
                                              TextWrapping="Wrap"
                                              Text="{loc:Text Grades_Voided_Description}"/>
                                <ui:Button Content="{loc:Text Grades_Voided_Restore}"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon ArrowUndo24}"
                                           Command="{Binding ViewModel.RestoreGradeCommand}"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </ui:Card>

                    <!-- Edit assessment -->
                    <ui:Card Style="{StaticResource ConditionalCardStyle}"
                             Visibility="{Binding ViewModel.IsEditingAssessment, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <HeaderedContentControl Header="{loc:Text Grades_EditAssessment_Header}"
                                                Margin="0"
                                                Style="{StaticResource Ng.Section}">
                            <StackPanel>
                                <HeaderedContentControl Header="{loc:Text Grades_Title_Header}"
                                                        Margin="{StaticResource Ng.Margin.Related}"
                                                        Style="{StaticResource Ng.FormField}">
                                    <ui:TextBox MaxLength="{x:Static services:AssessmentService.MaxTitleLength}"
                                                AutomationProperties.Name="{loc:Text Grades_EditAssessment_Title_A11y}"
                                                Text="{Binding ViewModel.EditAssessmentTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="{loc:Text Grades_Date_Header}"
                                                        Margin="{StaticResource Ng.Margin.Related}"
                                                        Style="{StaticResource Ng.FormField}">
                                    <DatePicker AutomationProperties.Name="{loc:Text Grades_EditAssessment_Date_A11y}"
                                                SelectedDate="{Binding ViewModel.EditAssessmentDate}"/>
                                </HeaderedContentControl>
                                <ui:TextBlock Margin="{StaticResource Ng.Margin.Related}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              TextWrapping="Wrap"
                                              Text="{loc:Text Grades_EditAssessment_Hint}"/>
                                <WrapPanel>
                                    <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                                               Content="{loc:Text Grades_EditAssessment_Save}"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Save24}"
                                               Command="{Binding ViewModel.SaveAssessmentEditCommand}"/>
                                    <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                                               Content="{loc:Text Common_Cancel}"
                                               Icon="{ui:SymbolIcon Dismiss24}"
                                               Command="{Binding ViewModel.CancelEditAssessmentCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </ui:Card>

                    <!-- Add assessment -->
                    <ui:Card Style="{StaticResource SectionCardStyle}">
                        <StackPanel IsEnabled="{Binding ViewModel.IsWritable}">
                            <HeaderedContentControl Header="{loc:Text Grades_AddAssessment_Header}"
                                                    Margin="0"
                                                    Style="{StaticResource Ng.Section}">
                                <StackPanel>
                                    <HeaderedContentControl Header="{loc:Text Grades_AddAssessment_Category_Header}"
                                                            Margin="{StaticResource Ng.Margin.Related}"
                                                            Style="{StaticResource Ng.FormField}">
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="{loc:Text Grades_AddAssessment_Category_A11y}"
                                                  ItemsSource="{Binding ViewModel.Buckets}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding ViewModel.NewAssessmentBucket}"/>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{loc:Text Grades_Title_Header}"
                                                            Margin="{StaticResource Ng.Margin.Related}"
                                                            Style="{StaticResource Ng.FormField}">
                                        <ui:TextBox MaxLength="{x:Static services:AssessmentService.MaxTitleLength}"
                                                    AutomationProperties.Name="{loc:Text Grades_AddAssessment_Title_A11y}"
                                                    PlaceholderText="{loc:Text Grades_AddAssessment_Title_Placeholder}"
                                                    Text="{Binding ViewModel.NewAssessmentTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="{loc:Text Grades_Date_Header}"
                                                            Margin="{StaticResource Ng.Margin.Related}"
                                                            Style="{StaticResource Ng.FormField}">
                                        <DatePicker AutomationProperties.Name="{loc:Text Grades_AddAssessment_Date_A11y}"
                                                    SelectedDate="{Binding ViewModel.NewAssessmentDate}"/>
                                    </HeaderedContentControl>
                                    <ui:TextBlock Margin="{StaticResource Ng.Margin.Related}"
                                                  FontTypography="Caption"
                                                  Appearance="Secondary"
                                                  TextWrapping="Wrap"
                                                  Text="{loc:Text Grades_AddAssessment_Hint}"/>
                                    <ui:Button Content="{loc:Text Grades_AddAssessment_Header}"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Add24}"
                                               Command="{Binding ViewModel.AddAssessmentCommand}"/>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ui:Card>

                    <!-- Assessments: the keyboard path to the actions in the column headers -->
                    <ui:Card Style="{StaticResource SectionCardStyle}">
                        <HeaderedContentControl Header="{loc:Text Grades_Assessments_Header}"
                                                Margin="0"
                                                Style="{StaticResource Ng.Section}">
                            <ItemsControl ItemsSource="{Binding ViewModel.Columns}"
                                          KeyboardNavigation.TabNavigation="Continue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type grades:GradeSheetColumn}">
                                        <Grid Margin="{StaticResource Ng.Margin.Tight}" Style="{StaticResource AssessmentColumnsOnlyStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource Ng.Margin.InlineGap}">
                                                <ui:TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Header}"/>
                                                <ui:TextBlock FontTypography="Caption"
                                                              Appearance="Secondary"
                                                              TextTrimming="CharacterEllipsis"
                                                              Text="{Binding BucketName}"/>
                                                <ui:TextBlock FontTypography="Caption"
                                                              Appearance="Secondary"
                                                              Text="{Binding SubHeader}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Margin="0,0,4,0"
                                                           Icon="{ui:SymbolIcon Edit24}"
                                                           ToolTip="{loc:Text Grades_Assessment_Edit_Tooltip}"
                                                           AutomationProperties.Name="{loc:Text Grades_EditAssessment_Header}"
                                                           Command="{Binding DataContext.ViewModel.BeginEditAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsVoided, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                <ui:Button Icon="{ui:SymbolIcon DismissCircle24}"
                                                           ToolTip="{loc:Text Grades_Assessment_Void_Tooltip}"
                                                           AutomationProperties.Name="{loc:Text Grades_Assessment_Void}"
                                                           Command="{Binding DataContext.ViewModel.VoidAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsVoided, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}"
                                                           ToolTip="{loc:Text Grades_Assessment_Restore_Tooltip}"
                                                           AutomationProperties.Name="{loc:Text Grades_Assessment_Restore}"
                                                           Command="{Binding DataContext.ViewModel.RestoreAssessmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsVoided, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </HeaderedContentControl>
                    </ui:Card>
                </WrapPanel>
            </ScrollViewer>
        </Expander>
    </Grid>
</Page>
