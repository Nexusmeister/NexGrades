<Page x:Class="NexGrades.App.Features.Subjects.SubjectDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:subjects="clr-namespace:NexGrades.App.Features.Subjects"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance subjects:SubjectDetailPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SubjectDetailPage">

    <StackPanel Margin="5,0,5, 0" Orientation="Vertical">
        <ui:TextBlock FontTypography="Title" 
                      Text="{Binding ViewModel.Title}"
                      Appearance="Secondary"/>
        <StackPanel Margin="0,5" Orientation="Horizontal">
            <ui:Button 
                Margin="0,0,5,0" 
                Content="Save" 
                Icon="{ui:SymbolIcon Save28}"
                />
            <ui:Button 
                Margin="0,0,5,0" 
                Content="Cancel" 
                Icon="{ui:SymbolIcon Prohibited28}"
                Command="{Binding ViewModel.CancelCommand}"/>
        </StackPanel>

        <ui:TextBox ClearButtonEnabled="True" PlaceholderText="Subject name" PlaceholderEnabled="True" Text="{Binding ViewModel.Subject.Name}"></ui:TextBox>
    </StackPanel>
</Page>
