<Page x:Class="NexGrades.App.Features.Subjects.SubjectDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:subjects="clr-namespace:NexGrades.App.Features.Subjects"
      xmlns:ds="clr-namespace:NexGrades.App.DesignSystem"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance subjects:SubjectDetailPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Subject">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{Binding ViewModel.Title}"
                                Style="{StaticResource Ng.PageHeader}" />

        <WrapPanel Grid.Row="1" Style="{StaticResource Ng.ActionBar}">
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                       Appearance="Primary"
                       IsDefault="True"
                       Content="Save"
                       Icon="{ui:SymbolIcon Save24}"
                       Command="{Binding ViewModel.SaveCommand}" />
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}"
                       IsCancel="True"
                       Content="Cancel"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding ViewModel.CancelCommand}" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ds:FormPanel Style="{StaticResource Ng.FormPanel}">
                <HeaderedContentControl Header="Subject name"
                                        Style="{StaticResource Ng.FormField}">
                    <ui:TextBox ClearButtonEnabled="True"
                                PlaceholderText="Subject name"
                                PlaceholderEnabled="True"
                                AutomationProperties.Name="Subject name"
                                MaxLength="{Binding ViewModel.MaxNameLength, Mode=OneTime}"
                                Text="{Binding ViewModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Short code"
                                        Style="{StaticResource Ng.FormField}">
                    <ui:TextBox ClearButtonEnabled="True"
                                PlaceholderText="Short code (e.g. MA)"
                                PlaceholderEnabled="True"
                                AutomationProperties.Name="Short code"
                                MaxLength="{Binding ViewModel.MaxShortCodeLength, Mode=OneTime}"
                                Text="{Binding ViewModel.ShortCode, UpdateSourceTrigger=PropertyChanged}" />
                </HeaderedContentControl>
            </ds:FormPanel>
        </ScrollViewer>
    </Grid>
</Page>
