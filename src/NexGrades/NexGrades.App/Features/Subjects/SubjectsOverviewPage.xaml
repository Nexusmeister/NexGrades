<Page x:Class="NexGrades.App.Features.Subjects.SubjectsOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="clr-namespace:NexGrades.App.Localization" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:subjects="clr-namespace:NexGrades.App.Features.Subjects"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance subjects:SubjectsOverviewPage, IsDesignTimeCreatable=False}"
      Title="{loc:Text Subjects_Overview_Title}">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding ViewModel.LoadSubjectsCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Style="{StaticResource Ng.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Grid.Row="0"
                                Header="{loc:Text Subjects_Overview_Title}"
                                Style="{StaticResource Ng.PageHeader}" />

        <WrapPanel Grid.Row="1" Style="{StaticResource Ng.ActionBar}">
            <ui:Button Margin="{StaticResource Ng.Margin.ActionItem}" Appearance="Primary"
                       Content="{loc:Text Subjects_Overview_Add}"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding ViewModel.AddSubjectCommand}" />
        </WrapPanel>

        <ContentControl Grid.Row="2"
                        Content="{loc:Text Subjects_Overview_Empty}"
                        Tag="{Binding ViewModel.Subjects}"
                        Style="{StaticResource Ng.EmptyState.WhenNoItemsAfterLoad}" />

        <ui:DataGrid Grid.Row="3"
                     Style="{StaticResource Ng.DataGrid}"
                     ItemsSource="{Binding ViewModel.Subjects}"
                     MouseDoubleClick="OnSubjectsGridMouseDoubleClick">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Text Subjects_Overview_Id_Header}" Binding="{Binding Id}"
                                    ElementStyle="{StaticResource Ng.DataGridText.Numeric}" />
                <DataGridTextColumn Header="{loc:Text Subjects_Overview_Name_Header}" Binding="{Binding Name}"
                                    ElementStyle="{StaticResource Ng.DataGridText}" />
                <DataGridTextColumn Header="{loc:Text Subjects_Overview_Code_Header}" Binding="{Binding ShortCode}"
                                    ElementStyle="{StaticResource Ng.DataGridText}" />
                <DataGridTemplateColumn Header="{loc:Text Subjects_Overview_Actions_Header}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                       ToolTip="{loc:Text Subjects_Overview_Edit_Tooltip}"
                                       AutomationProperties.Name="{loc:Text Subjects_Overview_Edit_Tooltip}"
                                       Command="{Binding DataContext.ViewModel.EditSubjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
