<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UserSecretsId>75c42a89-1b41-4aa6-8d68-8f4f9a086939</UserSecretsId>
  </PropertyGroup>

  <!-- Version comes from git tags `vX.Y.Z` (see docs/releasing.md). Untagged commits get X.Y.(Z+1)-beta.<height>;
       before the first tag the minimum 0.1 gives 0.1.0-beta.<height>. Beta release tags (vX.Y.Z-beta.N) are tags too:
       CI drops them from its clone before versioning; a local clone that fetched them shows X.Y.Z-beta.N.<height>,
       and you can delete them locally (git tag -d). -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>beta</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <!-- The Velopack package id, defined only here: the release workflow reads this property as the vpk pack id,
       and the app carries it as assembly metadata. Velopack installs to %LOCALAPPDATA%\<packId> and deletes that folder on
       uninstall, so it must never be `NexGrades`: that is the data folder with the database, its backups and the logs. -->
  <PropertyGroup>
    <NexGradesPackId>NexGrades.App</NexGradesPackId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="VelopackPackId" Value="$(NexGradesPackId)" />
  </ItemGroup>

  <!-- Program.Main is the entry point (Velopack must run first), so App.xaml is compiled as a page and no Main is
       generated from it. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Development settings never ship: drop them from a publish, keep them for build and F5. -->
  <Target Name="ExcludeDevelopmentSettingsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="WPF-UI.DependencyInjection" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexGrades.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexGrades.Common\NexGrades.Common.csproj" />
    <ProjectReference Include="..\NexGrades.Data\NexGrades.Data.csproj" />
    <ProjectReference Include="..\NexGrades.Domain\NexGrades.Domain.csproj" />
    <ProjectReference Include="..\Aspire\NexGrades.ServiceDefaults\NexGrades.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
