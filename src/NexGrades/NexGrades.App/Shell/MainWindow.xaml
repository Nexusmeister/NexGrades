<ui:FluentWindow x:Class="NexGrades.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:classes="clr-namespace:NexGrades.App.Features.Classes"
        xmlns:pages="clr-namespace:NexGrades.App.Features.Home"
        xmlns:schoolYears="clr-namespace:NexGrades.App.Features.SchoolYears"
        xmlns:settings="clr-namespace:NexGrades.App.Features.Settings"
        xmlns:students="clr-namespace:NexGrades.App.Features.Students"
        xmlns:subjects="clr-namespace:NexGrades.App.Features.Subjects"
        xmlns:shell="clr-namespace:NexGrades.App.Shell"
        d:DataContext="{d:DesignInstance shell:MainWindow, IsDesignTimeCreatable=True}"
        Width="1100"
        Height="650"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource Ng.FontFamily}"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Title="NexGrades" d:DesignHeight="450" d:DesignWidth="800">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding ElementName=AutoSuggestBox, Path=FocusCommand}"
            Modifiers="Control" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="NexGrades"
            Grid.Row="0"/>

        <!-- Update notice: closing only hides it; it opens again when another update is ready. -->
        <ui:InfoBar Grid.Row="1"
                    Margin="16,0,16,8"
                    Severity="Informational"
                    IsClosable="True"
                    IsOpen="{Binding ViewModel.UpdateNotice.IsOpen, Mode=TwoWay}"
                    Message="{Binding ViewModel.UpdateNotice.Message}"
                    AutomationProperties.Name="Update ready">
            <ui:Button Content="Restart now"
                       Appearance="Primary"
                       AutomationProperties.Name="Restart now"
                       ToolTip="Close NexGrades, install the update and start it again"
                       Command="{Binding ViewModel.UpdateNotice.RestartNowCommand}"/>
        </ui:InfoBar>

        <shell:GuardedNavigationView
            x:Name="RootNavigation"
            Grid.Row="2">
            <ui:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox x:Name="AutoSuggestBox" PlaceholderText="Search">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
            </ui:NavigationView.AutoSuggestBox>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" TargetPageType="{x:Type pages:HomePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Students" TargetPageType="{x:Type students:StudentsOverviewPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="People24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Classes" TargetPageType="{x:Type classes:ClassesOverviewPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="HatGraduation24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Subjects" TargetPageType="{x:Type subjects:SubjectsOverviewPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Glasses24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="School year" TargetPageType="{x:Type schoolYears:SchoolYearPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CalendarLtr24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type settings:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </shell:GuardedNavigationView>

        <!-- Host for content dialogs; spans all rows so the dialog overlay also covers the title bar. -->
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="3" />

    </Grid>
</ui:FluentWindow>
