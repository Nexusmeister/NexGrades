<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:ds="clr-namespace:NexGrades.App.DesignSystem">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/NexGrades.App;component/DesignSystem/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Shared styles. Views use them with StaticResource; theme brushes are DynamicResource so light and dark both work.
         ui:TextBlock replaces its Style at runtime, so no style here targets it: type is set with FontTypography and
         Appearance attributes in templates and views. No BasedOn uses DynamicResource (crashes at load). -->

    <!-- Page skeleton: rows 0 header, 1 action bar, 2 status, 3 content (*), 4 footer. Never a StackPanel root. -->
    <Style x:Key="Ng.PageRoot" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.Page}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Ng.FontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    </Style>

    <Style x:Key="Ng.PageHeader" TargetType="HeaderedContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <ui:TextBlock Text="{TemplateBinding Header}"
                                      FontTypography="Title"
                                      TextTrimming="CharacterEllipsis" />
                        <ContentPresenter x:Name="Caption"
                                          Margin="{StaticResource Ng.Margin.Tight}"
                                          TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ng.ActionBar" TargetType="WrapPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.ActionBar}" />
    </Style>

    <Style x:Key="Ng.Card" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
        <Setter Property="Padding" Value="{StaticResource Ng.Padding.Card}" />
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.Block}" />
    </Style>

    <Style x:Key="Ng.Card.Tile" TargetType="ui:Card" BasedOn="{StaticResource Ng.Card}">
        <Setter Property="Width" Value="{StaticResource Ng.Size.TileWidth}" />
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.Tile}" />
    </Style>

    <Style x:Key="Ng.Section" TargetType="HeaderedContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.Section}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <ui:TextBlock Text="{TemplateBinding Header}"
                                      FontTypography="Subtitle"
                                      Margin="{StaticResource Ng.Margin.Related}" />
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fills the width it gets up to Ng.Size.FormMaxWidth, left aligned. Use as <ds:FormPanel Style="{StaticResource Ng.FormPanel}">. -->
    <Style x:Key="Ng.FormPanel" TargetType="ds:FormPanel">
        <Setter Property="MaxFormWidth" Value="{StaticResource Ng.Size.FormMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Label above the field; the label is not a tab stop, the field inside is. -->
    <Style x:Key="Ng.FormField" TargetType="HeaderedContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.Block}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <ui:TextBlock Text="{TemplateBinding Header}"
                                      FontTypography="Body"
                                      Margin="{StaticResource Ng.Margin.Tight}" />
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ng.TextBox.Multiline" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource Ng.Size.MultilineMinHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource Ng.Size.MultilineMaxHeight}" />
    </Style>

    <Style x:Key="Ng.EmptyState" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.Block}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ui:TextBlock Text="{TemplateBinding Content}"
                                  FontTypography="Body"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Visible only while the collection bound to Tag is empty: Tag="{Binding ViewModel.Items}". -->
    <Style x:Key="Ng.EmptyState.WhenNoItems" TargetType="ContentControl" BasedOn="{StaticResource Ng.EmptyState}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Ng.DataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="Ng.DataGrid" TargetType="ui:DataGrid" BasedOn="{StaticResource {x:Type ui:DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="MinRowHeight" Value="{StaticResource Ng.Size.RowHeight}" />
        <Setter Property="RowStyle" Value="{StaticResource Ng.DataGridRow}" />
    </Style>

    <!-- ElementStyle for DataGridTextColumns. The library gives the displayed text its own margin, which adds to the
         cell padding and makes rows taller than Ng.Size.RowHeight; this replaces it with a horizontal inset that lines up with the header, and centres the text vertically. -->
    <Style x:Key="Ng.DataGridText" TargetType="TextBlock">
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.CellText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ElementStyle for numeric DataGridTextColumns. -->
    <Style x:Key="Ng.DataGridText.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Ng.DataGridText}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Ng.Surface.Item" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource Ng.Padding.Card}" />
        <Setter Property="CornerRadius" Value="{StaticResource Ng.Radius.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="Ng.SettingsCard" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="Margin" Value="{StaticResource Ng.Margin.Related}" />
    </Style>

    <!-- Header = setting name, Content = optional description. Used as CardControl.Header. -->
    <Style x:Key="Ng.SettingHeader" TargetType="HeaderedContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <ui:TextBlock Text="{TemplateBinding Header}"
                                      FontTypography="BodyStrong" />
                        <ui:TextBlock x:Name="Description"
                                      Text="{TemplateBinding Content}"
                                      FontTypography="Caption"
                                      Appearance="Secondary"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ng.Icon.Success" TargetType="ui:SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="Ng.Icon.Caution" TargetType="ui:SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="Ng.Icon.Critical" TargetType="ui:SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
</ResourceDictionary>
